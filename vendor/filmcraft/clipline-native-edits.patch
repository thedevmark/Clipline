+use std::collections::{BTreeMap,BTreeSet};
+use filmcraft_engine::{Session,EngineError,Result};
+use filmcraft_engine::project::{ClipId,ItemId,TrackItem};
+use filmcraft_engine::time::Tick;
+use serde::{Deserialize,Serialize};
+use serde_json::{Value,json};
+const KEY: &str="clipline.links.v1";
+const MAX_METADATA: usize=256*1024;
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Links {
+    schema: u32,
+    revision: u64,
+    shared_sequence: u64,
+    landscape_sequence: u64,
+    portrait_sequence: u64,
+    units: Vec<Unit>,
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    lineage: Vec<Ancestor>,
+    #[serde(flatten)]
+    extra: BTreeMap<String, Value>,
+}
+#[derive(Clone, Serialize, Deserialize)]
+struct Unit {
+    id: String,
+    parent: Option<String>,
+    shared: u64,
+    landscape: u64,
+    portrait: u64,
+    #[serde(flatten)]
+    extra: BTreeMap<String, Value>,
+}
+#[derive(Clone, Serialize, Deserialize)]
+struct Ancestor { id: String, parent: Option<String> }
+impl Links {
+    fn sequences(&self) -> [ItemId; 3] {
+        [ItemId(self.shared_sequence), ItemId(self.landscape_sequence), ItemId(self.portrait_sequence)]
+    }
+}
+impl Unit {
+    fn clips(&self) -> [ClipId; 3] { [ClipId(self.shared), ClipId(self.landscape), ClipId(self.portrait)] }
+    fn bind(&mut self, clips: [ClipId; 3]) {
+        [self.shared, self.landscape, self.portrait] = clips.map(|c| c.0);
+    }
+}
+
+fn clip(s:&Session,seq:ItemId,id:ClipId)->Result<&TrackItem> {
+    s.project.sequence(seq).and_then(|q|q.find_item(id)).map(|(_,c)|c).ok_or_else(||EngineError::Other("native clip missing".into()))
+}
+use std::sync::Arc;
+const TPS: i64 = filmcraft_engine::time::TICKS_PER_SECOND;
+
+fn run(s: &mut Session, id: &str, p: Value) -> Value { s.execute(id, p).unwrap() }
+fn fixture() -> (Session, ItemId) {
+    let mut s = Session::default();
+    run(&mut s, "file.newProject", json!({"name":"Linked command regression"}));
+    run(&mut s, "file.newOfflineFile", json!({"name":"Footage", "seconds":20,"fps":60,"video":true,"audio":true,"width":1920,"height":1080}));
+    let media = s.project.items.values().find(|i| i.as_media().is_some()).unwrap().id;
+    let mut seqs = Vec::new();
+    let mut ids = Vec::new();
+    for (name,w,h) in [("Shared",1920,1080),("Landscape",1920,1080),("Portrait",1080,1920)] {
+        let seq = run(&mut s, "file.newSequence", json!({"name":name,"fps":60,"video":2,"audio":2,"width":w,"height":h}))["sequence"].as_u64().unwrap();
+        run(&mut s, "timeline.place", json!({"item":media.0,"track":"V1","audioTrack":"A1","time":TPS,"sourceIn":2*TPS,"duration":6*TPS}));
+        seqs.push(seq);
+        ids.push(s.active_sequence().unwrap().video_tracks[0].items[0].id.0);
+    }
+    run(&mut s, "effects.apply", json!({"clips":[ids[2]],"effect":"crop"}));
+    run(&mut s, "effects.setParam", json!({"clip":ids[2],"effect":"crop","param":"left","value":22.0}));
+    run(&mut s, "effects.setParam", json!({"clip":ids[2],"effect":"motion","param":"position","value":[540,960],"keyframe":true,"time":TPS/2}));
+    run(&mut s, "effects.setParam", json!({"clip":ids[2],"effect":"motion","param":"position","value":[580,920],"keyframe":true,"time":5*TPS}));
+    let links = json!({"schema":1,"revision":0,"sourceAsset":"sha256:fixture-only","kit":{"id":"test-kit","version":3},
+        "sharedSequence":seqs[0],"landscapeSequence":seqs[1],"portraitSequence":seqs[2],
+        "units":[{"id":"root","parent":null,"shared":ids[0],"landscape":ids[1],"portrait":ids[2],"authored":"keep me"}]});
+    run(&mut s,"metadata.set",json!({"item":seqs[0],"field":KEY,"value":links.to_string()}));
+    (s, ItemId(seqs[0]))
+}
+fn links(s: &Session, owner: ItemId) -> Links { serde_json::from_str(&s.project.item(owner).unwrap().metadata[KEY]).unwrap() }
+fn snapshot(s: &Session) -> Value { serde_json::to_value(&*s.project).unwrap() }
+fn assert_rejected(s: &mut Session, id: &str, params: Value) {
+    let before = snapshot(s);
+    let rev = s.revision;
+    let undo = s.history.undo.len();
+    let redo = s.history.redo.len();
+    let journal = s.journal.clone();
+    let state = serde_json::to_value(&s.state).unwrap();
+    assert!(s.execute(id,params).is_err());
+    assert_eq!(snapshot(s), before);
+    assert_eq!(s.revision, rev);
+    assert_eq!((s.history.undo.len(),s.history.redo.len()),(undo,redo));
+    assert_eq!(s.journal,journal);
+    assert_eq!(serde_json::to_value(&s.state).unwrap(),state);
+}
+fn assert_units(s: &Session, owner: ItemId, count: usize) {
+    let m = links(s,owner);
+    let first=m.sequences()[0];
+    for u in &m.units {
+        let base=clip(s,first,u.clips()[0]).unwrap();
+        for (seq,id) in m.sequences().into_iter().zip(u.clips()) {
+            let native=clip(s,seq,id).unwrap();
+            assert_eq!((native.item,native.start,native.duration,native.source_in),(base.item,base.start,base.duration,base.source_in));
+        }
+    }
+    assert_eq!(m.units.len(),count);
+    for unit in &m.units {
+        assert_eq!(unit.extra["authored"],json!("keep me"));
+        for (seq,id) in m.sequences().into_iter().zip(unit.clips()) {
+            let q=s.project.sequence(seq).unwrap();
+            let c=clip(s,seq,id).unwrap();
+            let audio: Vec<_>=q.audio_tracks.iter().flat_map(|t|&t.items).filter(|a|a.link.is_some() && a.link==c.link).collect();
+            assert_eq!(audio.len(),1);
+            assert_eq!((audio[0].start,audio[0].duration,audio[0].source_in),(c.start,c.duration,c.source_in));
+        }
+    }
+}
