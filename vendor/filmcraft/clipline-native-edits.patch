+/// A validated project Arc and native settings, inaccessible to external mutation.
+pub struct Captured {
+    project: Arc<Project>,
+    outputs: Vec<Resolved>,
+    receipt: Value,
+}
+impl Captured {
+    pub fn receipt(&self) -> Value {
+        self.receipt.clone()
+    }
+    /// Synchronous sequential rendering; invoke only in the owned headless helper.
+    pub fn render(self, s: &mut Session) -> Result<Value> {
+        let mut results = Vec::new();
+        for output in self.outputs {
+            let started = std::time::Instant::now();
+            let performance_before = crate::perf::stats(s);
+            let gpu_before = filmcraft_export::gpu_render_stats();
+            // Reserve each previously absent destination exclusively before the
+            // native encoder replaces its own empty reservation. A failed render
+            // retains this namespace for the external owner's quarantine policy.
+            std::fs::OpenOptions::new().write(true).create_new(true).open(&output.settings.path).map_err(|e| bad(format!("cannot reserve output: {e}")))?;
+            let path = output.settings.path.clone();
+            let job = crate::export_tools::spawn_export(
+                s,
+                self.project.clone(),
+                output.sequence,
+                output.settings,
+                format!("Pinned {} export", output.composition),
+                true,
+            )?;
+            let terminal = s.jobs.iter().find(|j| j.id == job).map(|j| crate::export_tools::job_json(s, j)).ok_or_else(|| bad("native export job missing"))?;
+            let success =
+                terminal["finished"] == true && terminal["result"]["error"].is_null() && terminal["offlineMedia"].as_array().is_some_and(Vec::is_empty);
+            let gpu_after = filmcraft_export::gpu_render_stats();
+            results.push(json!({"performance":{"before":performance_before,"after":crate::perf::stats(s),
+                "wallSeconds":started.elapsed().as_secs_f64(),
+                "gpuFrames":gpu_after.frames.saturating_sub(gpu_before.frames),
+                "gpuFallbacks":gpu_after.fallbacks.saturating_sub(gpu_before.fallbacks)},
+                "composition":output.composition,"sequence":output.sequence.0,
+                "path":path,"facts":output.facts,"job":job,"terminal":terminal}));
+            if !success {
+                return Ok(json!({"schema":1,"state":"failed","capture":self.receipt,"outputs":results}));
+            }
+        }
+        Ok(json!({"schema":1,"state":"completed","capture":self.receipt,"outputs":results}))
+    }
+}
