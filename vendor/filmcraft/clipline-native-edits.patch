+use filmcraft_engine::{Session, project::ItemId};
+use serde_json::{Value, json};
+const TPS: i64 = filmcraft_engine::time::TICKS_PER_SECOND;
+const CMD: &str = "clipline.addCreativeTitle";
+const KEY: &str = "clipline.creativeTitles.v1";
+
+fn run(s: &mut Session, id: &str, p: Value) -> Value {
+    s.execute(id, p).unwrap()
+}
+fn fixture() -> (Session, Vec<u64>) {
+    let mut s = Session::default();
+    run(&mut s, "file.newProject", json!({"name":"Creative fixture"}));
+    run(&mut s, "file.newOfflineFile", json!({"name":"Footage","seconds":20,"fps":60,"video":true,"audio":true,"width":1920,"height":1080}));
+    let source = s.project.items.values().find(|i| i.as_media().is_some()).unwrap().id;
+    let mut sequences = Vec::new();
+    let mut clips = Vec::new();
+    for (name, w, h) in [("Shared", 1920, 1080), ("Landscape", 1920, 1080), ("Portrait", 1080, 1920)] {
+        let seq = run(&mut s, "file.newSequence", json!({"name":name,"fps":60,"video":2,"audio":2,"width":w,"height":h}))["sequence"].as_u64().unwrap();
+        run(&mut s, "timeline.place", json!({"item":source.0,"track":"V1","audioTrack":"A1","time":0,"sourceIn":0,"duration":6*TPS}));
+        clips.push(s.active_sequence().unwrap().video_tracks[0].items[0].id.0);
+        sequences.push(seq);
+    }
+    run(
+        &mut s,
+        "metadata.set",
+        json!({"item":sequences[0],"field":"clipline.links.v1","value":json!({
+        "schema":1,"revision":0,"sharedSequence":sequences[0],"landscapeSequence":sequences[1],"portraitSequence":sequences[2],
+        "units":[{"id":"root","parent":null,"shared":clips[0],"landscape":clips[1],"portrait":clips[2]}]}).to_string()}),
+    );
+    run(
+        &mut s,
+        "metadata.set",
+        json!({"item":sequences[0],"field":"clipline.creatorKit.v1","value":"{\"kitId\":\"fixture\",\"kitVersion\":3,\"sourceSHA256\":\"authored-fixture\"}"}),
+    );
+    run(&mut s, "sequence.open", json!({"item":sequences[0]}));
+    s.path = Some("C:/owned/working.fcproj".into());
+    (s, sequences)
+}
+fn request(s: &Session, sequences: &[u64]) -> Value {
+    json!({"expectedProjectPath":s.path,"expectedRevision":s.revision,
+        "expectedLinksRevisions":[{"owner":sequences[0],"revision":0}],"owner":sequences[0],"sequence":sequences[2],
+        "kind":"hook","text":"i picked the worst time to reload","durationSeconds":2.0,"placement":"top",
+        "recipe":"H04","evidence":"Reload and its consequence are visible in this authored fixture.","destination":null})
+}
+fn state(s: &Session) -> Value {
+    json!({"project":&*s.project,"state":s.state,"revision":s.revision,"saved":s.saved_revision,
+        "undo":s.history.undo.iter().map(|(label,p)|json!([label,&**p])).collect::<Vec<_>>(),
+        "redo":s.history.redo.iter().map(|(label,p)|json!([label,&**p])).collect::<Vec<_>>(),
+        "journal":s.journal,"events":s.events})
+}
+fn rejected(s: &mut Session, p: Value) {
+    let before = state(s);
+    assert!(s.execute(CMD, p).is_err());
+    assert_eq!(state(s), before);
+}
+
+#[test]
+fn explicit_inactive_title_preserves_other_compositions_and_is_one_undo() {
+    let (mut s, seqs) = fixture();
+    let before = serde_json::to_value(&*s.project).unwrap();
+    let ui = serde_json::to_value(&s.state).unwrap();
+    let undo = s.history.undo.len();
+    let shared = s.project.sequence(ItemId(seqs[0])).unwrap().clone();
+    let landscape = s.project.sequence(ItemId(seqs[1])).unwrap().clone();
+    let p = request(&s, &seqs);
+    let result = run(&mut s, CMD, p);
+    assert_eq!(result["sequence"], seqs[2]);
+    assert_eq!(result["startTicks"], 0);
+    assert_eq!(result["durationTicks"], 2 * TPS);
+    assert_eq!(s.project.sequence(ItemId(seqs[0])).unwrap(), &shared);
+    assert_eq!(s.project.sequence(ItemId(seqs[1])).unwrap(), &landscape);
+    assert_eq!(serde_json::to_value(&s.state).unwrap(), ui);
+    assert_eq!(s.history.undo.len(), undo + 1);
+    let after = serde_json::to_value(&*s.project).unwrap();
+    run(&mut s, "edit.undo", json!({}));
+    assert_eq!(serde_json::to_value(&*s.project).unwrap(), before);
+    run(&mut s, "edit.redo", json!({}));
+    assert_eq!(serde_json::to_value(&*s.project).unwrap(), after);
+}
