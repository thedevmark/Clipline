+/// Validate exact document/CAS/metadata, then capture one immutable native Arc.
+/// No export job, output write, history mutation or project adoption occurs here.
+pub fn capture(s: &mut Session, params: &Value) -> Result<Captured> {
+    if serde_json::to_vec(params).map_err(|e| bad(e.to_string()))?.len() > 65536 {
+        return Err(bad("capture request exceeds 64 KiB"));
+    }
+    if !params.is_object() || params.get("outputs").and_then(Value::as_array).is_none_or(|outputs| outputs.iter().any(|output| !output.is_object())) {
+        return Err(bad("capture parameters and output entries must be named objects"));
+    }
+    let request: Request = serde_json::from_value(params.clone()).map_err(|e| bad(e.to_string()))?;
+    if s.edit_group_depth != 0 || s.trim_play.active() {
+        return Err(bad("finish staged edits before capture"));
+    }
+    if request.expected_project_path.len() > 32768 || s.path.as_deref() != Some(request.expected_project_path.as_str()) {
+        return Err(bad("stale expectedProjectPath"));
+    }
+    if !sha(&request.expected_snapshot_sha256) || !sha(&request.expected_recipe_sha256) {
+        return Err(bad("canonical snapshot/recipe SHA256 required"));
+    }
+    let validation = crate::linked_edits::validate_command(
+        s,
+        &json!({"expectedRevision":request.expected_revision,
+        "expectedLinksRevisions":request.expected_links_revisions}),
+    )?;
+    let (bodies, hashes) = metadata(s, &validation)?;
+    if hashes != request.expected_owner_metadata_sha256 {
+        return Err(bad("stale owner metadata pins"));
+    }
+    if digest(&recipe())? != request.expected_recipe_sha256 {
+        return Err(bad("unsupported recipe pin"));
+    }
+    let size = s.services.file_size(&request.expected_project_path).map_err(|e| bad(e.to_string()))?;
+    if size == 0 || size > MAX_SNAPSHOT as u64 {
+        return Err(bad("snapshot exceeds 64 MiB"));
+    }
+    let bytes = s.services.read_range(&request.expected_project_path, 0, MAX_SNAPSHOT + 1).map_err(|e| bad(e.to_string()))?;
+    if bytes.len() > MAX_SNAPSHOT || bytes.len() as u64 != size || hash(&bytes) != request.expected_snapshot_sha256 {
+        return Err(bad("immutable snapshot bytes changed"));
+    }
+    let decoded = filmcraft_format::decode(&bytes).map_err(|e| bad(e.to_string()))?;
+    if decoded.project != *s.project {
+        return Err(bad("working project differs from immutable snapshot"));
+    }
+    if s.services.export_in_memory() {
+        return Err(bad("headless local filesystem export required"));
+    }
+    if request.outputs.is_empty() || request.outputs.len() > 2 {
+        return Err(bad("select one or two compositions"));
+    }
+    let owners = validation["owners"].as_array().ok_or_else(|| bad("invalid owner inventory"))?;
+    if owners.len() != 1 {
+        return Err(bad("this export profile requires one complete linked moment"));
+    }
+    let mut modes = std::collections::BTreeSet::new();
+    let mut paths = std::collections::BTreeSet::new();
+    let mut resolved = Vec::new();
+    for output in request.outputs {
+        if !matches!(output.composition.as_str(), "landscape" | "portrait") || !modes.insert(output.composition.clone()) {
+            return Err(bad("unknown or repeated composition"));
+        }
+        if owners[0]["sequences"][&output.composition].as_u64() != Some(output.sequence) {
+            return Err(bad("sequence does not match pinned composition"));
+        }
+        let path = Path::new(&output.path);
+        if output.path.len() > 32768
+            || !path.is_absolute()
+            || path.extension().and_then(|s| s.to_str()) != Some("mp4")
+            || !paths.insert(output.path.to_lowercase())
+            || path.exists()
+            || output.path == request.expected_project_path
+            || path.parent().is_none_or(|p| !p.is_dir())
+        {
+            return Err(bad("new explicit owned MP4 output paths required"));
+        }
+        let sequence = ItemId(output.sequence);
+        let q = s.project.sequence(sequence).ok_or_else(|| bad("missing sequence"))?;
+        if q.settings.par != (1, 1)
+            || q.duration().0 <= 0
+            || q.settings.width == q.settings.height
+            || (output.composition == "portrait") != (q.settings.height > q.settings.width)
+        {
+            return Err(bad("positive square-pixel composition with matching orientation required"));
+        }
+        let range = filmcraft_time::TimeRange::new(filmcraft_time::Tick::ZERO, q.duration());
+        let (_, mut settings) = crate::export_tools::settings_from_params(
+            s,
+            &json!({"format":"h264","gpuRendering":"auto",
+            "hardwareEncoding":"auto","burnCaptions":true,"settings":{"audio":{"codec":"aac","sampleRate":48000,"channels":2}}}),
+            "native.exportSnapshot",
+        )?;
+        settings.path = output.path;
+        settings.range = Some(range);
+        settings.pixel_aspect = Some((1, 1));
+        settings.validate().map_err(|e| bad(e.to_string()))?;
+        let actual = settings.resolve(q.settings.width, q.settings.height, q.settings.frame_rate, q.settings.sample_rate);
+        if actual.width == actual.height || (output.composition == "portrait") != (actual.height > actual.width) {
+            return Err(bad("resolved encoder geometry does not match the composition"));
+        }
+        let (a, b) = filmcraft_export::frame_span(actual.rate, range);
+        if b <= a {
+            return Err(bad("composition has no complete output frame"));
+        }
+        let facts = json!({"width":actual.width,"height":actual.height,"pixelAspect":[1,1],
+            "frameRate":{"num":actual.rate.num,"den":actual.rate.den},"frames":b-a,
+            "audio":{"sampleRate":actual.sample_rate,"channels":actual.channels},
+            "range":{"startTicks":range.start.0,"durationTicks":range.duration.0},"settings":settings});
+        resolved.push(Resolved { composition: output.composition, sequence, settings, facts });
+    }
+    let receipt = json!({"schema":1,"projectPath":s.path,"nativeRevision":s.revision,
+        "snapshotSHA256":request.expected_snapshot_sha256,"validation":validation,
+        "ownerMetadata":bodies,"ownerMetadataSHA256":hashes,"recipe":recipe(),"recipeSHA256":request.expected_recipe_sha256,
+        "mediaDependencies":dependencies(&s.project),
+        "outputs":resolved.iter().map(|o|json!({"composition":o.composition,"sequence":o.sequence.0,"path":o.settings.path,"facts":o.facts})).collect::<Vec<_>>()});
+    Ok(Captured { project: s.project.clone(), outputs: resolved, receipt })
+}
