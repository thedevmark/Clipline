+    let (mut s, seqs) = fixture();
+    let mut p = request(&s, &seqs);
+    p["kind"] = json!("cta");
+    p["recipe"] = json!("stream");
+    p["text"] = json!("come make the next bad decision with chat");
+    p["destination"] = json!("https://twitch.tv/authored");
