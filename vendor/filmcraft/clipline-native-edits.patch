+    let before = f.s.project.to_json();
+    let revision = f.s.revision;
+    let events = f.s.events.clone();
+    f.s.edit_group("Empty", |_| Ok(())).unwrap();
+    assert_eq!(f.s.project.to_json(), before);
+    assert_eq!(f.s.revision, revision);
+    assert_eq!(f.s.events, events);
+    assert_eq!(f.s.history.merge_key.as_deref(), Some("existing gesture"));
+}
+
+#[test]
+fn failure_from_saved_project_does_not_make_it_dirty_or_create_recovery() {
+    let mut f = Fixture::new();
+    let path = f.root.join("clean.fcproj");
+    f.s.execute("file.saveAs", json!({"path":path})).unwrap();
+    flush(&f.s);
+    assert!(!f.s.is_dirty());
+    let before = f.s.project.clone();
+    let revision = f.s.revision;
+    let recovery = f.s.persistence.as_ref().unwrap().session_dir.join("snapshot.fcproj");
+    assert!(!recovery.exists());
+    let r: Result<()> = f.s.edit_group("Rejected clean edit", |s| {
+        bin(s, "Do not save");
+        s.sync_persistence();
+        flush(s);
+        assert!(Arc::ptr_eq(&s.previews.live.project().unwrap(), &before));
+        assert!(!recovery.exists());
+        reject()
+    });
+    assert!(r.is_err());
+    assert!(!f.s.is_dirty());
+    assert_eq!(f.s.revision, revision);
+    assert!(!recovery.exists());
+    let mut reopened = Session::default();
+    reopened.execute("file.open", json!({"path":path})).unwrap();
+    assert_eq!(reopened.project.to_json(), before.to_json());
+}
