-    pub fn redo(&mut self) -> Option<String> {
-        let (label, next) = self.history.redo.pop()?;
-        self.history.merge_key = None;
-        let cur = std::mem::replace(&mut self.project, next);
-        self.history.undo.push((label.clone(), cur));
-        self.fix_state();
-        self.bump();
-        Some(label)
-    }
