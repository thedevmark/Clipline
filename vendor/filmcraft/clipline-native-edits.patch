+/// Serde structs otherwise accept positional JSON arrays. Wire records must be objects.
+struct Object<T>(T);
+impl<'de, T: Deserialize<'de>> Deserialize<'de> for Object<T> {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct Visitor<T>(std::marker::PhantomData<T>);
+        impl<'de, T: Deserialize<'de>> serde::de::Visitor<'de> for Visitor<T> {
+            type Value = Object<T>;
+            fn expecting(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                f.write_str("a JSON object required")
+            }
+            fn visit_map<A: serde::de::MapAccess<'de>>(
+                self,
+                map: A,
+            ) -> Result<Self::Value, A::Error> {
+                T::deserialize(serde::de::value::MapAccessDeserializer::new(map)).map(Object)
+            }
+        }
+        deserializer.deserialize_map(Visitor(std::marker::PhantomData))
+    }
+}
+fn object<'de, D: serde::Deserializer<'de>, T: Deserialize<'de>>(d: D) -> Result<T, D::Error> {
+    Object::<T>::deserialize(d).map(|v| v.0)
+}
+fn objects<'de, D: serde::Deserializer<'de>, T: Deserialize<'de>>(
+    d: D,
+) -> Result<Vec<T>, D::Error> {
+    Vec::<Object<T>>::deserialize(d).map(|v| v.into_iter().map(|o| o.0).collect())
+}
+fn object_values<'de, D: serde::Deserializer<'de>, T: Deserialize<'de>>(
+    d: D,
+) -> Result<BTreeMap<String, T>, D::Error> {
+    BTreeMap::<String, Object<T>>::deserialize(d)
+        .map(|v| v.into_iter().map(|(k, o)| (k, o.0)).collect())
+}
+fn parse_object<T: serde::de::DeserializeOwned>(bytes: &[u8]) -> R<T> {
+    check(
+        bytes.len() <= MAX_DOCUMENT,
+        "document exceeds candidate bound",
+    )?;
+    serde_json::from_slice::<Object<T>>(bytes)
+        .map(|v| v.0)
+        .map_err(|e| bad(e.to_string()))
+}
+
+/// Supported static audio presentation only. Native placement owns identity/timing/link.
+fn copy_static_audio(target: &mut TrackItem, prototype: &TrackItem) {
+    target.effects.clone_from(&prototype.effects);
+    target.gain_db = prototype.gain_db;
+    target.enabled = prototype.enabled;
+    target.scale_to_frame = prototype.scale_to_frame;
+    target.essential.clone_from(&prototype.essential);
+    target
+        .source_channels
+        .clone_from(&prototype.source_channels);
+    target.audio_stream = prototype.audio_stream;
+}
+
+fn same_static_audio(a: &TrackItem, b: &TrackItem) -> bool {
+    a.effects == b.effects
+        && a.gain_db == b.gain_db
+        && a.enabled == b.enabled
+        && a.scale_to_frame == b.scale_to_frame
+        && a.essential == b.essential
+        && a.source_channels == b.source_channels
+        && a.audio_stream == b.audio_stream
+}
+
+fn validate_static_primary_audio(audio: &TrackItem) -> R<()> {
+    check(
+        audio.speed == 1.0
+            && !audio.reverse
+            && audio.frame_hold.is_none()
+            && audio.markers.is_empty()
+            && audio.effects.iter().all(|e| !e.is_animated()),
+        "only static normal-speed nonreversed audio without hold/markers is supported",
+    )?;
+    check(
+        audio.audio_stream == 0,
+        "Creator Kit supports the primary audio stream only",
+    )
+}
+
+fn validate_audio_channels(audio: &TrackItem, channels: usize) -> R<()> {
+    validate_static_primary_audio(audio)?;
+    check(
+        (1..=2).contains(&channels)
+            && audio.source_channels.len() <= 2
+            && audio
+                .source_channels
+                .iter()
+                .all(|&channel| usize::from(channel) < channels),
+        "template audio channel selection is incompatible with the actual mono/stereo source",
+    )
+}
+
+fn clip(p: &Project, seq: u64, id: u64) -> R<TrackItem> {
+    p.sequence(ItemId(seq))
+        .and_then(|q| q.find_item(ClipId(id)))
+        .map(|(_, c)| c.clone())
+        .ok_or_else(|| bad("missing native slot"))
+}
