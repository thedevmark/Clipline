+    kit_version: u64,
+    overrides: BTreeMap<String, Value>,
+    revision: u64,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    schema: u32,
+    #[serde(deserialize_with = "object")]
+    moment: Moment,
+    #[serde(deserialize_with = "object")]
+    kit: Kit,
+    #[serde(deserialize_with = "object")]
+    template: Asset,
+    #[serde(deserialize_with = "object")]
+    source: Asset,
+    profile_id: String,
+    scene_key: String,
+}
+
+#[derive(Default)]
+struct Stats {
+    opens: AtomicU64,
+    calls: AtomicU64,
+    bytes: AtomicU64,
+    max: AtomicU64,
+    ranges: AtomicU64,
+    whole: AtomicU64,
+}
+impl Stats {
+    fn value(&self) -> Value {
+        json!({"readerOpens":self.opens.load(Ordering::Relaxed),"readCalls":self.calls.load(Ordering::Relaxed),
+    "readerBytes":self.bytes.load(Ordering::Relaxed),"maxReadBytes":self.max.load(Ordering::Relaxed),
+    "identityRangeBytes":self.ranges.load(Ordering::Relaxed),"wholeSourceBufferAttempts":self.whole.load(Ordering::Relaxed)})
+    }
+}
+struct Counted {
+    inner: filmcraft_media::reader::FileReader,
+    stats: Arc<Stats>,
+}
+impl ByteReader for Counted {
+    fn len(&self) -> u64 {
+        self.inner.len()
+    }
+    fn read_at(&self, offset: u64, buf: &mut [u8]) -> std::io::Result<()> {
+        self.stats.calls.fetch_add(1, Ordering::Relaxed);
+        self.stats
+            .bytes
+            .fetch_add(buf.len() as u64, Ordering::Relaxed);
+        self.stats
+            .max
+            .fetch_max(buf.len() as u64, Ordering::Relaxed);
+        self.inner.read_at(offset, buf)
+    }
+}
+struct Host {
+    source: String,
+    output: String,
+    stats: Arc<Stats>,
+    pinned_template: Option<(String, Vec<u8>)>,
+}
+impl Services for Host {
+    fn read_file(&self, path: &str) -> std::io::Result<Vec<u8>> {
+        if let Some((name, bytes)) = &self.pinned_template {
+            if path == name {
+                return Ok(bytes.clone());
+            }
+        }
+        if path == self.source {
+            self.stats.whole.fetch_add(1, Ordering::Relaxed);
+            return Err(std::io::Error::other("whole source buffering forbidden"));
+        }
+        FsServices.read_file(path)
+    }
+    fn write_file(&self, path: &str, bytes: &[u8]) -> std::io::Result<()> {
+        if path != self.output {
+            return Err(std::io::Error::other(
+                "only the unique candidate output may be written",
+            ));
+        }
+        let mut file = fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(path)?;
+        file.write_all(bytes)?;
+        file.sync_all()
+    }
+    fn file_size(&self, path: &str) -> std::io::Result<u64> {
+        FsServices.file_size(path)
+    }
+    fn read_range(&self, path: &str, offset: u64, len: usize) -> std::io::Result<Vec<u8>> {
+        let bytes = FsServices.read_range(path, offset, len)?;
+        if path == self.source {
+            self.stats
+                .ranges
+                .fetch_add(bytes.len() as u64, Ordering::Relaxed);
+        }
+        Ok(bytes)
+    }
+    fn reader(&self, path: &str) -> Option<std::io::Result<SharedReader>> {
+        if path != self.source {
+            return FsServices.reader(path);
+        }
+        self.stats.opens.fetch_add(1, Ordering::Relaxed);
+        Some(
+            filmcraft_media::reader::FileReader::open(Path::new(path)).map(|inner| {
+                Arc::new(Counted {
+                    inner,
+                    stats: self.stats.clone(),
+                }) as SharedReader
+            }),
+        )
+    }
+}
+
+/// Capture the existing illustrative native layout. No final creative styling is selected here.
+fn capture_native(seed: &str, profile: Profile, output: &str) -> R<Value> {
+    profile.validate()?;
+    let mut s = Session::default();
+    let seed_bytes = read_small(seed)?;
+    let stats = Arc::new(Stats::default());
+    s.services = Arc::new(Host {
+        source: String::new(),
+        output: output.into(),
+        stats,
+        pinned_template: Some((seed.into(), seed_bytes)),
+    });
+    run(&mut s, "file.open", json!({"path":seed}))?;
+    run(&mut s, "clipline.validate", json!({}))?;
+    let owners: Vec<_> = s
+        .project
+        .items
+        .values()
+        .filter(|item| item.metadata.contains_key(LINKS))
+        .map(|i| i.id)
+        .collect();
+    check(
+        owners.len() == 1 && s.project.items.len() == 4,
+        "candidate capture requires exactly one media and three sequences",
+    )?;
+    let owner = owners[0];
+    let item = s.project.item(owner).ok_or_else(|| bad("owner missing"))?;
+    let links: Value =
+        serde_json::from_str(&item.metadata[LINKS]).map_err(|e| bad(e.to_string()))?;
+    check(links["schema"] == 2, "schema2 bundle seed required")?;
+    let units = links["units"]
+        .as_array()
+        .ok_or_else(|| bad("native units missing"))?;
+    let roles = units
+        .first()
+        .and_then(|u| u["roles"].as_array())
+        .ok_or_else(|| bad("first unit roles missing"))?;
+    check(
+        (1..=2).contains(&roles.len()),
+        "one gameplay and optional facecam role required",
+    )?;
+    let mut p = (*s.project).clone();
+    let mut compositions = Vec::new();
+    let mut source = None;
+    for (name, key) in [
+        ("shared", "sharedSequence"),
+        ("landscape", "landscapeSequence"),
+        ("portrait", "portraitSequence"),
+    ] {
+        let sid = links[key]
+            .as_u64()
+            .ok_or_else(|| bad("sequence binding missing"))?;
+        let q = p
+            .sequence(ItemId(sid))
+            .ok_or_else(|| bad("sequence missing"))?;
+        check(
+            q.caption_tracks.iter().all(|t| t.captions.is_empty())
+                && q.markers.is_empty()
+                && q.all_tracks().all(|t| t.transitions.is_empty()),
+            "caption content, markers and transitions need a separate duration policy",
+        )?;
+        let mut slots = Vec::new();
+        let mut keep = BTreeSet::new();
+        for role in roles {
+            let label = role["role"].as_str().ok_or_else(|| bad("role missing"))?;
+            check(
+                label == "gameplay" || label == "facecam",
+                "unsupported role",
+            )?;
+            check(
+                profile.regions.contains_key(label),
+                "the selected profile must name each authored source region",
+            )?;
+            let cid = role[name]
+                .as_u64()
+                .ok_or_else(|| bad("clip binding missing"))?;
+            let (track, c) = q
+                .find_item(ClipId(cid))
+                .ok_or_else(|| bad("slot clip missing"))?;
+            check(
+                c.start == Tick::ZERO
+                    && c.speed == 1.
+                    && !c.reverse
+                    && c.frame_hold.is_none()
+                    && c.markers.is_empty()
+                    && c.effects.iter().all(|e| !e.is_animated()),
+                "only static full-moment role slots supported",
+            )?;
+            check(
+                source.is_none_or(|id| id == c.item.0),
+                "one placeholder source required",
+            )?;
+            source = Some(c.item.0);
+            keep.insert(c.id);
+            let partners: Vec<_> = q
+                .audio_tracks
+                .iter()
+                .flat_map(|t| {
+                    t.items
+                        .iter()
+                        .filter(move |a| c.link.is_some() && a.link == c.link)
+                        .map(move |a| (t.id, a.id))
+                })
+                .collect();
+            check(
+                (label == "gameplay" && partners.len() == 1)
+                    || (label == "facecam" && partners.is_empty() && c.link.is_none()),
+                "gameplay needs single native audio; facecam needs none",
+            )?;
+            let audio = partners.first().copied();
+            if let Some((_, id)) = audio {
+                keep.insert(id);
+            }
+            if let Some((_, id)) = audio {
+                validate_static_primary_audio(&clip(&p, sid, id.0)?)?;
+            }
+            // Timing differs across native cuts. Appearance/audio semantics may not silently disappear.
+            for later in units.iter().skip(1) {
+                let later_roles = later["roles"]
+                    .as_array()
+                    .ok_or_else(|| bad("later unit roles missing"))?;
+                check(
+                    later_roles.len() == roles.len(),
+                    "capture requires equal role sets across native units",
+                )?;
+                let matches: Vec<_> = later_roles
+                    .iter()
+                    .filter(|r| r["role"].as_str() == Some(label))
+                    .collect();
+                check(
+                    matches.len() == 1,
+                    "capture requires equal role sets across native units",
+                )?;
+                let other_id = matches[0][name]
+                    .as_u64()
+                    .ok_or_else(|| bad("later clip binding missing"))?;
+                let (other_track, other) = q
+                    .find_item(ClipId(other_id))
+                    .ok_or_else(|| bad("later native slot missing"))?;
+                check(
+                    other_track == track
+                        && other.item == c.item
+                        && other.speed == 1.
+                        && !other.reverse
+                        && other.frame_hold.is_none()
+                        && other.markers.is_empty()
+                        && other.effects.iter().all(|e| !e.is_animated())
+                        && other.effects == c.effects
+                        && other.gain_db == c.gain_db
+                        && other.enabled == c.enabled
+                        && other.scale_to_frame == c.scale_to_frame,
+                    "later native unit has different template semantics; explicit unit selection is not implemented",
+                )?;
+                let other_audio: Vec<_> = q
+                    .audio_tracks
+                    .iter()
+                    .flat_map(|t| {
+                        t.items
+                            .iter()
+                            .filter(move |a| other.link.is_some() && a.link == other.link)
+                            .map(move |a| (t.id, a))
+                    })
+                    .collect();
+                check(
+                    other_audio.len() == partners.len(),
+                    "later native unit has different audio ownership",
+                )?;
+                if let Some((expected_track, expected_id)) = audio {
+                    let expected = clip(&p, sid, expected_id.0)?;
+                    let (actual_track, actual) = other_audio[0];
+                    validate_static_primary_audio(actual)?;
+                    check(
+                        actual_track == expected_track
+                            && actual.item == expected.item
+                            && actual.speed == expected.speed
+                            && actual.reverse == expected.reverse
+                            && actual.frame_hold == expected.frame_hold
+                            && actual.markers.is_empty()
+                            && actual.effects.iter().all(|e| !e.is_animated())
+                            && same_static_audio(actual, &expected),
+                        "later native unit has different audio template semantics; explicit unit selection is not implemented",
+                    )?;
+                } else {
+                    check(
+                        other.link.is_none(),
+                        "later facecam has unexpected native audio link",
+                    )?;
+                }
+            }
+            slots.push(Slot {
+                role: label.into(),
+                video_track: track.0,
+                prototype_clip: cid,
+                audio_track: audio.map(|x| x.0.0),
+                prototype_audio: audio.map(|x| x.1.0),
+            });
+        }
+        check(
+            slots.iter().any(|x| x.role == "gameplay"),
+            "gameplay slot required",
+        )?;
+        let composition = Composition {
+            name: name.into(),
+            sequence: sid,
+            width: q.settings.width,
+            height: q.settings.height,
+            slots,
+        };
+        let q = p
+            .sequence_mut(ItemId(sid))
+            .ok_or_else(|| bad("sequence missing"))?;
+        for track in q.video_tracks.iter_mut().chain(q.audio_tracks.iter_mut()) {
+            track.items.retain(|c| keep.contains(&c.id));
+        }
+        compositions.push(composition);
+    }
+    let source = source.ok_or_else(|| bad("source missing"))?;
+    let media = p
+        .item(ItemId(source))
+        .and_then(|i| i.as_media())
+        .ok_or_else(|| bad("media missing"))?;
+    let video = media
+        .info
+        .video
+        .as_ref()
+        .ok_or_else(|| bad("video required"))?;
+    check(
+        (video.width, video.height) == (profile.source_width, profile.source_height)
+            && video.par == (1, 1),
+        "profile and native square-pixel dimensions differ",
+    )?;
+    check(
+        media.info.audio_streams.len() == 1,
+        "Creator Kit requires one mono/stereo audio stream",
+    )?;
+    let channels = media.info.audio_streams[0].channels as usize;
+    for composition in &compositions {
+        for slot in &composition.slots {
+            if let Some(id) = slot.prototype_audio {
+                validate_audio_channels(&clip(&p, composition.sequence, id)?, channels)?;
+            }
+        }
+    }
+    for item in p.items.values_mut() {
+        item.metadata.remove(LINKS);
+        item.metadata.remove("clipline.acceptedCaptions.v1");
+        item.metadata.remove(INSTANCE);
+    }
+    let blueprint=Blueprint{schema:1,profile,placeholder_source:source,compositions,scope:"static full-moment illustrative native layout; one selected source; not complete Creator Kit assets".into()};
+    let encoded = String::from_utf8(json_bytes(&blueprint)?).map_err(|e| bad(e.to_string()))?;
+    p.item_mut(owner)
+        .ok_or_else(|| bad("owner missing"))?
+        .metadata
+        .insert(TEMPLATE.into(), encoded);
+    s.project = Arc::new(p);
+    run(
+        &mut s,
+        "file.saveAsTemplate",
+        json!({"path":output,"name":"Reusable native proof layout"}),
+    )?;
+    Ok(
+        json!({"status":"captured","template":output,"sha256":hash(&read_small(output)?),"blueprint":blueprint,"styling":"copied unchanged from supplied native proof, not a final creator style"}),
+    )
+}
+
+fn exact_range(a: i64, b: i64, rate: FrameRate, available: Tick) -> R<(Tick, Tick)> {
+    check(
+        a >= 0 && a < b && rate.num > 0 && rate.den > 0,
+        "invalid interval/rational source rate",
+    )?;
+    check(
+        i128::from(TICKS_PER_SECOND) * i128::from(rate.den) % i128::from(rate.num) == 0,
+        "candidate requires an exact native frame tick; unsupported exotic rate",
+    )?;
+    let units = |u: i64| -> R<Tick> {
+        let value = i128::from(u) * i128::from(TICKS_PER_SECOND) / 1_000_000;
+        check(value < i128::from(Tick::MAX.0), "source interval overflow")?;
+        Ok(Tick(value as i64))
+    };
+    let lo = units(a)?;
+    let hi = units(b)?;
+    check(
+        hi <= available,
+        "selected range exceeds native media handles",
+    )?;
+    let frame = rate.frame_at(lo);
+    let floor = rate.tick_of(frame);
+    let start = if floor < lo {
+        rate.tick_of(frame.checked_add(1).ok_or_else(|| bad("frame overflow"))?)
+    } else {
+        floor
+    };
+    let end = rate.snap(hi);
+    check(
+        start < end,
+        "selected interval contains no complete native frame",
+    )?;
+    Ok((start, end - start))
+}
+
+/// Creates a separate native document. It cannot replace or mutate any caller's Session.
+fn instantiate_native(request: Request, output: &str) -> R<Value> {
+    let r = &request;
+    check(
+        r.schema == 2 && r.kit.version > 0 && r.moment.revision > 0,
+        "unsupported request",
+    )?;
+    check(
+        hash(r.kit.descriptor_json.as_bytes()) == r.kit.descriptor_sha256,
+        "canonical Kit descriptor fingerprint changed",
+    )?;
+    let descriptor: KitDescriptor = parse_object(r.kit.descriptor_json.as_bytes())?;
+    for id in [&r.moment.id, &r.kit.id, &r.template.id, &r.source.id] {
+        uuid(id)?;
+    }
+    check(
+        r.moment.kit_id == r.kit.id
+            && r.moment.kit_version == r.kit.version
+            && r.moment.source_asset_id == r.source.id,
+        "moment identity differs from pinned Kit/source",
+    )?;
+    check(
+        descriptor.properties.is_empty() && r.moment.overrides.is_empty(),
+        "generic property bindings/overrides are not implemented in this first native factory",
+    )?;
+    check(
+        descriptor.asset_refs.len() == 1
+            && descriptor.asset_refs.get("native_template") == Some(&r.template.id),
+        "first candidate supports the registered native_template asset only",
+    )?;
+    let bytes = read_small(&r.template.path)?;
+    check(
+        hash(&bytes) == r.template.sha256 && bytes.len() as u64 == r.template.bytes,
+        "template fingerprint changed",
+    )?;
+    let (source_sha, source_bytes) = fingerprint(&r.source.path)?;
+    check(
+        source_sha == r.source.sha256 && source_bytes == r.source.bytes,
+        "source fingerprint changed",
+    )?;
+    let stats = Arc::new(Stats::default());
+    let host: Arc<dyn Services> = Arc::new(Host {
+        source: r.source.path.clone(),
+        output: output.into(),
+        stats: stats.clone(),
+        pinned_template: Some((r.template.path.clone(), bytes)),
+    });
+    let mut s = Session::default();
+    s.services = host.clone();
+    run(
+        &mut s,
+        "file.newProjectFromTemplate",
+        json!({"template":r.template.path,"name":r.moment.title}),
+    )?;
+    let holders: Vec<_> = s
+        .project
+        .items
+        .values()
+        .filter(|i| i.metadata.contains_key(TEMPLATE))
+        .map(|i| i.id)
