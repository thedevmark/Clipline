+//! Regression coverage for external visibility, not only eventual project rollback.
+use filmcraft_engine::{EngineError, Event, Result, Session, autosave::AutosaveConfig};
+use serde_json::{Value, json};
+use std::{path::PathBuf, sync::{Arc, atomic::{AtomicUsize, Ordering}}, time::Duration};
+
+static NEXT: AtomicUsize = AtomicUsize::new(0);
+
+struct Fixture { s: Session, root: PathBuf }
+impl Fixture {
+    fn new() -> Self {
+        let root = PathBuf::from(std::env::var_os("CLIPLINE_TEST_ROOT").expect("set an owned test output root"))
+            .join(format!("{}-{}", std::process::id(), NEXT.fetch_add(1, Ordering::Relaxed)));
+        std::fs::create_dir_all(&root).unwrap();
+        let mut s = Session::default();
+        let mut cfg = AutosaveConfig::new(root.join("autosave"));
+        cfg.journal_debounce = Duration::ZERO;
+        s.start_autosave(cfg).unwrap();
+        bin(&mut s, "Committed baseline");
+        flush(&s);
+        s.drain_events();
+        Self { s, root }
+    }
+}
+impl Drop for Fixture { fn drop(&mut self) { self.s.shutdown(); } }
+fn bin(s: &mut Session, name: &str) { s.execute("file.newBin", json!({"name":name})).unwrap(); }
+fn reject<T>() -> Result<T> { Err(EngineError::Other("injected failure".into())) }
+fn flush(s: &Session) { s.persistence.as_ref().unwrap().flush(); }
+fn recovered(s: &Session) -> String {
+    flush(s);
+    let path = s.persistence.as_ref().unwrap().session_dir.join("snapshot.fcproj");
+    let mut recovery = Session::default();
+    recovery.execute("file.open", json!({"path":path})).unwrap();
+    recovery.project.to_json()
+}
+fn same_external(s: &Session, before: &Arc<filmcraft_project::Project>) {
+    assert!(Arc::ptr_eq(&s.previews.live.project().unwrap(), before), "playback received a staged Arc");
+    assert_eq!(recovered(s), before.to_json(), "worker persisted a staged project");
+}
+
+#[test]
+fn successful_group_publishes_only_final_snapshot_and_one_revision_event() {
+    let mut f = Fixture::new();
+    let before = f.s.previews.live.project().unwrap();
+    let undo = f.s.history.undo.len();
+    let journal = f.s.journal.len();
+    f.s.edit_group("Linked change", |s| {
+        bin(s, "Landscape");
+        same_external(s, &before);
+        s.sync_persistence(); // Even an explicit sync cannot publish an open group.
+        same_external(s, &before);
+        bin(s, "Portrait");
+        same_external(s, &before);
+        Ok(())
+    }).unwrap();
+    assert!(Arc::ptr_eq(&f.s.previews.live.project().unwrap(), &f.s.project));
+    assert_eq!(recovered(&f.s), f.s.project.to_json());
+    assert_eq!(f.s.history.undo.len(), undo + 1);
+    assert_eq!(f.s.history.undo.last().unwrap().0, "Linked change");
+    assert_eq!(f.s.journal.len(), journal + 2);
+    assert_eq!(f.s.drain_events(), vec![Event::ProjectChanged { revision:f.s.revision }]);
+}
+
+#[test]
+fn failed_group_never_publishes_and_restores_observable_buffers() {
+    let mut f = Fixture::new();
+    f.s.toast("Existing event");
+    let before = f.s.previews.live.project().unwrap();
+    let (rev, saved, events, journal, undo, state) = (f.s.revision, f.s.saved_revision, f.s.events.clone(), f.s.journal.clone(), f.s.history.undo.len(), serde_json::to_value(&f.s.state).unwrap());
+    let result: Result<()> = f.s.edit_group("Rejected", |s| {
+        bin(s, "Rejected prefix");
+        s.toast("Rejected toast");
+        same_external(s, &before);
+        reject()
+    });
+    assert!(result.is_err());
+    assert!(Arc::ptr_eq(&f.s.project, &before));
+    same_external(&f.s, &before);
+    assert_eq!((f.s.revision, f.s.saved_revision), (rev, saved));
+    assert_eq!(f.s.events, events);
+    assert_eq!(f.s.journal, journal);
+    assert_eq!(f.s.history.undo.len(), undo);
+    assert_eq!(serde_json::to_value(&f.s.state).unwrap(), state);
+    assert_eq!(f.s.is_dirty(), rev != saved);
+}
+
+#[test]
+fn panic_restores_observers_and_next_command_can_commit() {
+    let mut f = Fixture::new();
+    let before = f.s.previews.live.project().unwrap();
+    let (revision, limit, journal, events) = (f.s.revision, f.s.history.limit, f.s.journal.clone(), f.s.events.clone());
+    let p = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let _: Result<()> = f.s.edit_group("Panicking group", |s| {
+            bin(s, "Rejected panic prefix");
+            same_external(s, &before);
+            panic!("injected group panic")
+        });
+    }));
+    assert!(p.is_err());
+    same_external(&f.s, &before);
+    assert_eq!(f.s.revision, revision);
+    assert_eq!(f.s.history.limit, limit);
+    assert_eq!(f.s.journal, journal);
+    assert_eq!(f.s.events, events);
+    bin(&mut f.s, "Valid next command");
+    assert!(Arc::ptr_eq(&f.s.previews.live.project().unwrap(), &f.s.project));
+    assert_eq!(recovered(&f.s), f.s.project.to_json());
+}
