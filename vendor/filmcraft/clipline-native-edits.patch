+    let journal = f.s.journal.clone();
+    let result: Result<()> = f.s.edit_group("Outer", |s| {
+        bin(s, "Outer prefix");
+        s.edit_group("Inner", |s| { bin(s, "Inner success"); same_external(s, &before); Ok(()) })?;
+        same_external(s, &before);
+        reject()
+    });
+    assert!(result.is_err());
+    same_external(&f.s, &before);
+    assert_eq!(f.s.project.to_json(), before.to_json());
+    assert_eq!(f.s.journal, journal);
+}
