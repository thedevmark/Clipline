+struct Blueprint {
+    schema: u32,
+    profile: Profile,
+    placeholder_source: u64,
+    compositions: Vec<Composition>,
+    scope: String,
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Asset {
+    id: String,
+    path: String,
+    sha256: String,
+    bytes: u64,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct KitDescriptor {
+    name: String,
+    asset_refs: BTreeMap<String, String>,
+    properties: BTreeMap<String, Value>,
+    #[serde(deserialize_with = "objects")]
+    layout_profiles: Vec<Profile>,
+    vocabulary: Vec<String>,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Kit {
+    id: String,
+    version: u64,
