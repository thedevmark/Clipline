+        "sharedSequence":seqs[0],"landscapeSequence":seqs[1],"portraitSequence":seqs[2],
+        "units":[{"id":"root","parent":null,"shared":ids[0],"landscape":ids[1],"portrait":ids[2],"authored":"keep me"}]});
+    run(&mut s,"metadata.set",json!({"item":seqs[0],"field":KEY,"value":links.to_string()}));
+    (s, ItemId(seqs[0]))
+}
+fn links(s: &Session, owner: ItemId) -> Links { serde_json::from_str(&s.project.item(owner).unwrap().metadata[KEY]).unwrap() }
+fn snapshot(s: &Session) -> Value { serde_json::to_value(&*s.project).unwrap() }
+fn assert_rejected(s: &mut Session, id: &str, params: Value) {
+    let before = snapshot(s);
+    let rev = s.revision;
+    let undo = s.history.undo.len();
+    let redo = s.history.redo.len();
+    let journal = s.journal.clone();
+    let state = serde_json::to_value(&s.state).unwrap();
+    assert!(s.execute(id,params).is_err());
+    assert_eq!(snapshot(s), before);
+    assert_eq!(s.revision, rev);
+    assert_eq!((s.history.undo.len(),s.history.redo.len()),(undo,redo));
+    assert_eq!(s.journal,journal);
+    assert_eq!(serde_json::to_value(&s.state).unwrap(),state);
+}
+fn assert_units(s: &Session, owner: ItemId, count: usize) {
+    let m = links(s,owner);
+    validate(s,owner,&m).unwrap();
+    assert_eq!(m.units.len(),count);
+    for unit in &m.units {
+        assert_eq!(unit.extra["authored"],json!("keep me"));
+        for (seq,id) in m.sequences().into_iter().zip(unit.clips()) {
+            let q=s.project.sequence(seq).unwrap();
+            let c=clip(s,seq,id).unwrap();
+            let audio: Vec<_>=q.audio_tracks.iter().flat_map(|t|&t.items).filter(|a|a.link.is_some() && a.link==c.link).collect();
+            assert_eq!(audio.len(),1);
+            assert_eq!((audio[0].start,audio[0].duration,audio[0].source_in),(c.start,c.duration,c.source_in));
+        }
+    }
+}
