+fn links(s: &Session, owner: ItemId) -> Links { serde_json::from_str(&s.project.item(owner).unwrap().metadata[KEY]).unwrap() }
+fn snapshot(s: &Session) -> Value { serde_json::to_value(&*s.project).unwrap() }
+fn assert_rejected(s: &mut Session, id: &str, params: Value) {
+    let before = snapshot(s);
+    let rev = s.revision;
+    let undo = s.history.undo.len();
+    let redo = s.history.redo.len();
+    let journal = s.journal.clone();
+    let state = serde_json::to_value(&s.state).unwrap();
+    assert!(s.execute(id,params).is_err());
+    assert_eq!(snapshot(s), before);
+    assert_eq!(s.revision, rev);
+    assert_eq!((s.history.undo.len(),s.history.redo.len()),(undo,redo));
+    assert_eq!(s.journal,journal);
+    assert_eq!(serde_json::to_value(&s.state).unwrap(),state);
