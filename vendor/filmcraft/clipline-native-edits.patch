+//! Gated headless protocol. The engine owns capture, native clocks and rendering.
+use serde_json::{Value, json};
+use std::io::{BufRead, Write};
+fn line(input: &mut impl BufRead, max: usize) -> Result<String, Box<dyn std::error::Error>> {
+    let mut bytes = Vec::new();
+    loop {
+        let available = input.fill_buf()?;
+        if available.is_empty() {
+            return Err("protocol ended before an explicit instruction".into());
+        }
+        let n = available.iter().position(|b| *b == b'\n').map_or(available.len(), |i| i + 1);
+        if bytes.len() + n > max {
+            return Err("protocol line exceeds bound".into());
+        }
+        bytes.extend_from_slice(&available[..n]);
+        input.consume(n);
+        if bytes.last() == Some(&b'\n') {
+            return Ok(String::from_utf8(bytes)?);
+        }
+    }
+}
+fn emit(value: Value) -> Result<(), Box<dyn std::error::Error>> {
+    let stdout = std::io::stdout();
+    let mut stream = stdout.lock();
+    serde_json::to_writer(&mut stream, &value)?;
+    stream.write_all(b"\n")?;
+    stream.flush()?;
+    Ok(())
+}
+// Same off-screen adapter used by the published Filmcraft CLI.
+struct GpuFrameRenderer(filmcraft_gpu::ExportRenderer);
+impl filmcraft_export::FrameRenderer for GpuFrameRenderer {
+    fn render(
+        &mut self,
+        project: &filmcraft_project::Project,
+        seq: filmcraft_project::ItemId,
+        t: filmcraft_time::Tick,
+        opts: filmcraft_render::RenderOptions,
+        sources: &dyn filmcraft_render::SourceProvider,
+    ) -> Option<filmcraft_render::Image> {
+        self.0.render(project, seq, t, opts, sources)
+    }
+}
+fn register_gpu_frame_renderer() {
+    filmcraft_export::register_frame_renderer(|| {
+        filmcraft_gpu::ExportRenderer::new().map(|r| Box::new(GpuFrameRenderer(r)) as Box<dyn filmcraft_export::FrameRenderer>)
+    });
+}
+fn acceleration_stats() -> Value {
+    let gpu = filmcraft_export::gpu_render_stats();
+    let timings = filmcraft_gpu::export_renderer::timing::get();
+    let hw = filmcraft_export::hw_encode_stats();
+    json!({"gpuFrames":gpu.frames,"gpuFallbacks":gpu.fallbacks,
+        "gpuCompositedFrames":timings.frames,"gpuSubmitMs":timings.submit.as_secs_f64()*1000.0,
+        "gpuReadbackWaitMs":timings.map_wait.as_secs_f64()*1000.0,
+        "gpuReadbackConvertMs":timings.convert.as_secs_f64()*1000.0,
+        "hardwareFrames":hw.frames,"hardwareSessions":hw.sessions,"hardwareDeclined":hw.declined})
+}
+
+fn run() -> Result<(), Box<dyn std::error::Error>> {
+    let input = std::io::stdin();
+    let mut input = input.lock();
+    // The parent attaches the new process to its Job Object before this gate.
+    if line(&mut input, 32)? != "start\n" {
+        return Err("owned launch gate was not released".into());
+    }
+    let args: Vec<_> = std::env::args().collect();
+    if args.len() != 2 {
+        return Err("usage: clipline-export-snapshot OWNED_WORKING_PROJECT".into());
+    }
+    filmcraft_platform::register();
+    register_gpu_frame_renderer();
+    let mut session = filmcraft_engine::Session::default();
+    session.execute("file.open", json!({"path":args[1]}))?;
+    emit(json!({"event":"ready","observation":filmcraft_engine::export_snapshot::inspect(&mut session)?}))?;
+    let params: Value = serde_json::from_str(&line(&mut input, 65537)?)?;
+    let captured = filmcraft_engine::export_snapshot::capture(&mut session, &params)?;
+    emit(json!({"event":"captured","capture":captured.receipt()}))?;
+    // The parent verifies the native resolved source paths/closure before export.
+    if line(&mut input, 32)? != "render\n" {
+        return Err("render authorization was not received".into());
+    }
+    let before = acceleration_stats();
+    let mut result = captured.render(&mut session)?;
+    result["acceleration"] = json!({"profile":"clipline.h264.gpu-auto.v1",
+        "before":before,"after":acceleration_stats(),"perf":session.execute("perf.stats", json!({}))?});
+    emit(json!({"event":"result","result":result}))?;
+    Ok(())
+}
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    if let Err(error) = run() {
+        let _ = emit(json!({"event":"error","message":error.to_string()}));
+        return Err(error);
+    }
+    Ok(())
+}
