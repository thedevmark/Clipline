+//! A guarded title on one explicit linked composition; native graphics own the edit.
+use crate::{EngineError, Result, Session};
+use filmcraft_project::{ClipId, ItemId};
+use filmcraft_time::Tick;
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+const COMMAND: &str = "clipline.addCreativeTitle";
+pub(crate) const KEY: &str = "clipline.creativeTitles.v1";
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Request {
+    expected_project_path: String,
+    expected_revision: u64,
+    expected_links_revisions: Value,
+    owner: u64,
+    sequence: u64,
+    kind: String,
+    text: String,
+    duration_seconds: f64,
+    placement: String,
+    recipe: String,
+    evidence: String,
+    destination: Option<String>,
+}
+
+fn bad(message: impl Into<String>) -> EngineError {
+    EngineError::BadParams { cmd: COMMAND.into(), msg: message.into() }
+}
+fn bounded(text: &str, maximum: usize) -> bool {
+    !text.trim().is_empty() && text.len() <= maximum && !text.chars().any(|c| c.is_control())
+}
+fn request(s: &mut Session, p: &Value) -> Result<Request> {
+    if !p.is_object() {
+        return Err(bad("title parameters must be an object"));
+    }
+    let r: Request = serde_json::from_value(p.clone()).map_err(|_| bad("invalid or unknown title parameter"))?;
+    if s.path.as_deref() != Some(r.expected_project_path.as_str()) || r.expected_project_path.is_empty() {
+        return Err(bad("the working project changed"));
+    }
+    if s.trim_play.active() || s.edit_group_depth != 0 {
+        return Err(bad("finish the staged edit or trim playback first"));
+    }
+    if !matches!(r.kind.as_str(), "hook" | "cta")
+        || !matches!(r.placement.as_str(), "top" | "bottom")
+        || !bounded(&r.text, 1024)
+        || r.text.chars().count() > 160
+        || !bounded(&r.recipe, 64)
+        || !bounded(&r.evidence, 2000)
+        || !r.duration_seconds.is_finite()
+        || !(0.25..=5.0).contains(&r.duration_seconds)
+    {
+        return Err(bad("use one short approved title, evidence, placement and 0.25–5 seconds"));
+    }
+    if let Some(destination) = &r.destination {
+        if r.kind != "cta" || !bounded(destination, 2048) || !destination.starts_with("https://") || destination.chars().any(char::is_whitespace) {
+            return Err(bad("CTA destination must be an explicit bounded HTTPS address"));
+        }
+    }
+    let inventory = crate::linked_edits::validate_command(
+        s,
+        &json!({
+            "expectedRevision":r.expected_revision,"expectedLinksRevisions":r.expected_links_revisions
+        }),
+    )?;
+    let owner = inventory["owners"]
+        .as_array()
+        .and_then(|owners| owners.iter().find(|v| v["owner"].as_u64() == Some(r.owner)))
+        .ok_or_else(|| bad("the requested linked owner is absent"))?;
+    if !["shared", "landscape", "portrait"].iter().any(|role| owner["sequences"][*role].as_u64() == Some(r.sequence)) {
+        return Err(bad("the title must target one composition of that linked owner"));
+    }
+    Ok(r)
+}
+
+pub(crate) fn preflight(s: &mut Session, id: &str, p: &Value) -> Result<()> {
+    if id == COMMAND {
+        request(s, p)?;
+    }
+    Ok(())
+}
+
+pub(crate) fn add(s: &mut Session, p: &Value) -> Result<Value> {
+    let r = request(s, p)?;
+    let owner = ItemId(r.owner);
+    let sequence = ItemId(r.sequence);
+    let item = s.project.item(owner).ok_or_else(|| bad("missing title owner"))?;
+    let creation = item
+        .metadata
+        .get("clipline.creatorKit.v1")
+        .filter(|v| v.len() <= 32768)
+        .cloned()
+        .ok_or_else(|| bad("the saved Creator Kit creation identity is required"))?;
+    let mut records: Vec<Value> = match item.metadata.get(KEY) {
+        None => Vec::new(),
+        Some(raw) if raw.len() <= 65536 => serde_json::from_str(raw).map_err(|_| bad("invalid title provenance"))?,
+        _ => return Err(bad("title provenance exceeds its bound")),
+    };
+    if records.len() > 6
+        || records
+            .iter()
+            .any(|v| !v.is_object() || v["sequence"].as_u64().is_none() || v["clip"].as_u64().is_none() || !matches!(v["kind"].as_str(), Some("hook" | "cta")))
+    {
+        return Err(bad("invalid title provenance entries"));
+    }
+    for entry in &records {
+        if entry["sequence"].as_u64() == Some(r.sequence)
+            && entry["kind"].as_str() == Some(r.kind.as_str())
+            && entry["clip"].as_u64().is_some_and(|id| s.project.sequence(sequence).is_some_and(|q| q.find_item(ClipId(id)).is_some()))
+        {
+            return Err(bad("this composition already has that title; edit its graphic in Filmcraft instead of replacing it"));
+        }
+    }
+    records.retain(|entry| entry["sequence"].as_u64() != Some(r.sequence) || entry["kind"].as_str() != Some(r.kind.as_str()));
+    if records.len() >= 6 {
+        return Err(bad("the title slot inventory is full"));
+    }
+    let q = s.project.sequence(sequence).ok_or_else(|| bad("missing title composition"))?;
+    let rate = q.settings.frame_rate;
+    let end = rate.snap(q.duration());
+    if end < rate.frame_duration() {
+        return Err(bad("the composition has no complete native frame"));
+    }
+    let duration = rate.snap_nearest(Tick::from_seconds_f64(r.duration_seconds)).max(rate.frame_duration()).min(end);
+    let start = if r.kind == "hook" { Tick::ZERO } else { end - duration };
+    let (w, h) = (q.settings.width as f64, q.settings.height as f64);
+    let y = if r.placement == "top" { h * 0.12 } else { h * 0.70 };
+    let size = w.min(h) * 0.055;
+    s.edit_group("Add creative title", |s| {
+        let ui = s.state.clone();
+        s.state.active_sequence = Some(sequence);
+        let created = s.execute_linked_native(
+            "graphics.newText",
+            &json!({
+                "text":r.text,"newClip":true,"time":start.0,"seconds":duration.seconds(),
+                "position":[w*0.08,y],"box":[w*0.84,h*0.25],"size":size,"font":"Segoe UI","fontStyle":"Bold"
+            }),
+        )?;
+        let clip = created["clip"].as_u64().ok_or_else(|| bad("native graphics did not return its clip"))?;
+        // The explicit plain text remains exact even when native smart quotes are enabled.
+        s.execute_linked_native("graphics.setText", &json!({"clip":clip,"layer":0,"text":r.text}))?;
+        s.execute_linked_native(
+            "graphics.set",
+            &json!({"clip":clip,"layer":0,"props":{
+                "align":"center","fill_color":"#ffffff","stroke":true,"stroke_width":3,"background":true
+            }}),
+        )?;
+        let native = s.project.sequence(sequence).and_then(|q| q.find_item(ClipId(clip))).map(|(_, c)| c).ok_or_else(|| bad("the native title is absent"))?;
+        if native.start != start || native.duration != duration {
+            return Err(bad("the native title range differs"));
+        }
+        let result = json!({"sequence":r.sequence,"owner":r.owner,"clip":clip,"kind":r.kind,
+            "text":r.text,"startTicks":start.0,"durationTicks":duration.0,"recipe":r.recipe,
+            "evidence":r.evidence,"destination":r.destination,"performance":"unmeasured",
+            "creatorKitIdentity":creation,"scope":"one explicit composition"});
+        records.push(result.clone());
+        let raw = serde_json::to_string(&records).map_err(|_| bad("title provenance cannot be encoded"))?;
+        if raw.len() > 65536 {
+            return Err(bad("title provenance exceeds its bound"));
+        }
+        s.edit("Creative title provenance", |pr, _| {
+            pr.item_mut(owner).ok_or_else(|| bad("title owner disappeared"))?.metadata.insert(KEY.into(), raw);
+            Ok(())
+        })?;
+        s.state = ui;
+        Ok(result)
+    })
+}
