-        if let Some(seq) = self.state.active_sequence.and_then(|s| p.sequence(s)) {
-            self.state.selection.retain(|c| seq.find_item(*c).is_some());
-            self.state.caption_selection.retain(|c| seq.find_caption(*c).is_some());
