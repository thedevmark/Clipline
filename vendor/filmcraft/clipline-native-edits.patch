+ let m=manifest_value(&s,owner);for unit in m["units"].as_array().unwrap(){for role in unit["roles"].as_array().unwrap(){for(seq,id)in sequences_value(&m).into_iter().zip(role_ids(role)){assert_eq!(serde_json::to_value(&clip(&s,seq,id).unwrap().effects).unwrap(),effects[&(seq,role["role"].as_str().unwrap().to_string())]);}}}
