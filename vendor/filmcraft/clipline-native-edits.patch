+//! Public capture boundary tests. No GUI command installs this blocking API.
+use filmcraft_engine::{Session, export_snapshot};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::{path::PathBuf, sync::Arc};
+
+fn fixture() -> (Session, PathBuf, Value) {
+    let parent = PathBuf::from(std::env::var_os("CLIPLINE_EXPORT_TEST_ROOT").expect("explicit owned fixture root required"));
+    assert!(parent.is_absolute() && parent.is_dir());
+    let root = parent.join(format!("clipline-export-owner-{}", uuid::Uuid::new_v4()));
+    std::fs::create_dir(&root).unwrap();
+    let mut s = Session::default();
+    s.execute("file.newProject", json!({"name":"Export capture"})).unwrap();
+    s.execute("file.newOfflineFile", json!({"name":"Offline fixture","seconds":2,"fps":60,"video":true,"audio":true,"width":64,"height":36})).unwrap();
+    let source = s.project.items.values().find(|i| i.as_media().is_some()).unwrap().id;
+    let mut sequences = Vec::new();
+    let mut clips = Vec::new();
+    for (name, w, h) in [("Shared", 64, 36), ("Landscape", 64, 36), ("Portrait", 36, 64)] {
+        let sequence =
+            s.execute("file.newSequence", json!({"name":name,"fps":60,"video":1,"audio":1,"width":w,"height":h})).unwrap()["sequence"].as_u64().unwrap();
+        s.execute(
+            "timeline.place",
+            json!({"item":source.0,"track":"V1","audioTrack":"A1","time":0,"sourceIn":0,"duration":3*filmcraft_engine::time::TICKS_PER_SECOND/60}),
+        )
+        .unwrap();
+        clips.push(s.active_sequence().unwrap().video_tracks[0].items[0].id.0);
+        sequences.push(sequence);
+    }
+    s.execute("metadata.set",json!({"item":sequences[0],"field":"clipline.links.v1","value":json!({"schema":1,"revision":0,"sharedSequence":sequences[0],"landscapeSequence":sequences[1],"portraitSequence":sequences[2],"units":[{"id":"fixture-root","parent":null,"shared":clips[0],"landscape":clips[1],"portrait":clips[2]}]}).to_string()})).unwrap();
+    let path = root.join("working.fcproj");
+    s.execute("file.saveAs", json!({"path":path})).unwrap();
+    let observation = export_snapshot::inspect(&mut s).unwrap();
+    let bytes = std::fs::read(&path).unwrap();
+    let params = json!({"expectedProjectPath":s.path,"expectedRevision":s.revision,
+        "expectedLinksRevisions":[{"owner":sequences[0],"revision":0}],"expectedSnapshotSHA256":format!("{:x}",Sha256::digest(bytes)),
+        "expectedOwnerMetadataSHA256":observation["ownerMetadataSHA256"],"expectedRecipeSHA256":observation["recipeSHA256"],
+        "outputs":[{"composition":"landscape","sequence":sequences[1],"path":root.join("landscape.mp4")},{"composition":"portrait","sequence":sequences[2],"path":root.join("portrait.mp4")}]});
+    (s, root, params)
+}
+fn reject(s: &mut Session, root: &PathBuf, params: &Value) {
+    let before = (*s.project).clone();
+    let rev = s.revision;
+    let undo = s.history.undo.len();
+    let redo = s.history.redo.len();
+    assert!(export_snapshot::capture(s, params).is_err());
+    assert_eq!(*s.project, before);
+    assert_eq!(s.revision, rev);
+    assert_eq!(s.history.undo.len(), undo);
+    assert_eq!(s.history.redo.len(), redo);
+    assert!(s.jobs.is_empty());
+    assert!(!root.join("landscape.mp4").exists());
+    assert!(!root.join("portrait.mp4").exists());
+}
