-        self.previews.live.publish_project(self.project.clone());
-        if r.is_ok() && spec.journal {
-            self.journal.push((id.to_string(), params));
-            if self.journal.len() > 10_000 {
-                self.journal.drain(..1000);
-            }
-        }
