-        if r.is_ok() && spec.journal && id.starts_with("graphics.") && !self.project.source_graphics.is_empty() {
-            graphic_templates::sync_source_graphics(self);
-        }
-        if self.exec_depth == 0
-            && let Err(e) = &r
