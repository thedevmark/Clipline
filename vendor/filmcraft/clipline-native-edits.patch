+/// Validate CAS and write one native snapshot without adopting it as the working file.
+fn save_linked_snapshot(s: &mut Session, params: &Value) -> Result<Value> {
+    const CMD: &str = "clipline.saveSnapshot";
+    let object = params.as_object().ok_or_else(|| bad(CMD, "parameters must be an object"))?;
+    if object.len() != 4 || !object.contains_key("expectedProjectPath") || !object.contains_key("expectedRevision") || !object.contains_key("expectedLinksRevisions")
+        || object.keys().any(|k| k != "path" && k != "expectedProjectPath" && k != "expectedRevision" && k != "expectedLinksRevisions") {
+        return Err(bad(CMD, "require exactly path, expectedProjectPath, expectedRevision and complete expectedLinksRevisions"));
+    }
+    let path = object.get("path").and_then(Value::as_str).filter(|p| !p.trim().is_empty())
+        .ok_or_else(|| bad(CMD, "need a nonempty explicit path"))?;
+    let matches_project = match &object["expectedProjectPath"] {
+        Value::Null => s.path.is_none(),
+        Value::String(expected) => s.path.as_deref() == Some(expected.as_str()),
+        _ => false,
+    };
+    if !matches_project { return Err(bad(CMD, "stale or invalid expectedProjectPath")); }
+    if s.edit_group_depth != 0 || s.trim_play.active() {
+        return Err(bad(CMD, "finish the staged edit or trim playback before saving a snapshot"));
+    }
+    let mut validation = crate::linked_edits::validate_command(s, &json!({
+        "expectedRevision":object["expectedRevision"],"expectedLinksRevisions":object["expectedLinksRevisions"]
+    }))?;
+    validation["projectPath"] = json!(s.path);
+    let saved = write_project(s, path, false)?;
+    Ok(json!({"path":saved["path"],"validation":validation}))
+}
