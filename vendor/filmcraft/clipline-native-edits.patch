+ let mut sequences=Vec::new();let mut videos=Vec::new();let mut cams=Vec::new();let mut tracks=Vec::new();
+ for (i,(name,w,h)) in [("Shared",1920,1080),("Landscape",1920,1080),("Portrait",1080,1920)].into_iter().enumerate(){
+  let q=run(&mut s,"file.newSequence",json!({"name":name,"width":w,"height":h,"fps":60,"video":2,"audio":2}))["sequence"].as_u64().unwrap();
+  run(&mut s,"timeline.place",json!({"item":media.0,"track":"V1","audioTrack":"A1","time":TPS,"sourceIn":2*TPS,"duration":6*TPS}));
+  videos.push(s.active_sequence().unwrap().video_tracks[0].items[0].id.0);
+  run(&mut s,"timeline.place",json!({"item":media.0,"track":"V2","audio":false,"time":TPS,"sourceIn":2*TPS,"duration":6*TPS}));
