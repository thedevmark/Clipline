+//! Creator Kit creation owner extracted from the qualified native factory.
+//!
+//! Creates a fresh scratch Session; never replaces a caller's live document.
+//! Static full-moment illustrative native slots only. Not a complete Kit feature.
+//! Caller supplies canonical, expected-revision-admitted library records. The native
+//! creation receipt is not library authority and cannot update canonical rows.
+//! These blocking operations require a background owner; no command registration
+//! or UI-thread execution is added here. External import I/O is not edit-group atomic.
+use crate::project::{ClipId, ItemId, Project, TrackItem};
+use crate::{EngineError, FsServices, Services, Session};
+use filmcraft_media::{ByteReader, SharedReader};
+use filmcraft_time::{FrameRate, TICKS_PER_SECOND, Tick};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fs,
+    io::{Read, Write},
+    path::Path,
+    sync::{
+        Arc,
+        atomic::{AtomicU64, Ordering},
+    },
+};
+
+const LINKS: &str = "clipline.links.v1";
+const TEMPLATE: &str = "clipline.creatorKitTemplate.v1";
+const INSTANCE: &str = "clipline.creatorKit.v1";
+const MAX_DOCUMENT: usize = 2 * 1024 * 1024;
+type R<T> = Result<T, EngineError>;
+fn bad(message: impl Into<String>) -> EngineError {
+    EngineError::Other(message.into())
+}
+fn check(ok: bool, message: &str) -> R<()> {
+    if ok { Ok(()) } else { Err(bad(message)) }
+}
+fn uuid(value: &str) -> R<()> {
+    check(
+        uuid::Uuid::parse_str(value).is_ok_and(|v| v.to_string() == value),
+        "canonical UUID required",
+    )
+}
+fn hash(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+fn json_bytes(value: &impl Serialize) -> R<Vec<u8>> {
+    serde_json::to_vec(value).map_err(|e| bad(e.to_string()))
+}
+fn read_small(path: &str) -> R<Vec<u8>> {
+    let mut file = fs::File::open(path).map_err(|e| bad(e.to_string()))?;
+    let mut bytes = Vec::new();
+    Read::by_ref(&mut file)
+        .take(MAX_DOCUMENT as u64 + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|e| bad(e.to_string()))?;
+    check(
+        bytes.len() <= MAX_DOCUMENT,
+        "document exceeds candidate bound",
+    )?;
+    Ok(bytes)
+}
+fn fingerprint(path: &str) -> R<(String, u64)> {
+    check(
+        Path::new(path).is_absolute() && !path.starts_with("\\\\") && !path.starts_with("//"),
+        "absolute local file required",
+    )?;
+    let mut file = fs::File::open(path).map_err(|e| bad(e.to_string()))?;
+    let before = file.metadata().map_err(|e| bad(e.to_string()))?;
+    check(
+        before.is_file() && before.len() <= 2 * 1024 * 1024 * 1024,
+        "regular source at most2GiB required",
+    )?;
+    let mut digest = Sha256::new();
+    let mut buffer = [0_u8; 65536];
+    let mut count = 0;
+    loop {
+        let n = file.read(&mut buffer).map_err(|e| bad(e.to_string()))?;
+        if n == 0 {
+            break;
+        }
+        digest.update(&buffer[..n]);
+        count += n as u64;
+    }
+    let after = file.metadata().map_err(|e| bad(e.to_string()))?;
+    let located = fs::metadata(path).map_err(|e| bad(e.to_string()))?;
+    check(
+        before.len() == count
+            && after.len() == count
+            && located.len() == count
+            && before.modified().ok() == after.modified().ok()
+            && after.modified().ok() == located.modified().ok(),
+        "source changed during point-in-time fingerprint",
+    )?;
+    Ok((format!("{:x}", digest.finalize()), count))
+}
+fn run(s: &mut Session, id: &str, p: Value) -> R<Value> {
+    s.execute(id, p)
+}
