+//! Creator Kit creation owner extracted from the qualified native factory.
+//!
+//! Creates a fresh scratch Session; never replaces a caller's live document.
+//! Static full-moment illustrative native slots only. Not a complete Kit feature.
+//! Caller supplies canonical, expected-revision-admitted library records. The native
+//! creation receipt is not library authority and cannot update canonical rows.
+//! These blocking operations require a background owner; no command registration
+//! or UI-thread execution is added here. External import I/O is not edit-group atomic.
+use crate::project::{ClipId, ItemId, Project, TrackItem};
+use crate::{EngineError, FsServices, Services, Session};
+use filmcraft_media::{ByteReader, SharedReader};
+use filmcraft_time::{FrameRate, TICKS_PER_SECOND, Tick};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fs,
+    io::{Read, Write},
+    path::Path,
+    sync::{
+        Arc,
+        atomic::{AtomicU64, Ordering},
+    },
+};
+
+const LINKS: &str = "clipline.links.v1";
+const TEMPLATE: &str = "clipline.creatorKitTemplate.v1";
+const INSTANCE: &str = "clipline.creatorKit.v1";
+const MAX_DOCUMENT: usize = 2 * 1024 * 1024;
+type R<T> = Result<T, EngineError>;
+fn bad(message: impl Into<String>) -> EngineError {
+    EngineError::Other(message.into())
+}
+fn check(ok: bool, message: &str) -> R<()> {
+    if ok { Ok(()) } else { Err(bad(message)) }
+}
+fn uuid(value: &str) -> R<()> {
+    check(
+        uuid::Uuid::parse_str(value).is_ok_and(|v| v.to_string() == value),
+        "canonical UUID required",
+    )
+}
+fn hash(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+fn json_bytes(value: &impl Serialize) -> R<Vec<u8>> {
+    serde_json::to_vec(value).map_err(|e| bad(e.to_string()))
+}
+fn read_small(path: &str) -> R<Vec<u8>> {
+    let mut file = fs::File::open(path).map_err(|e| bad(e.to_string()))?;
+    let mut bytes = Vec::new();
+    Read::by_ref(&mut file)
+        .take(MAX_DOCUMENT as u64 + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|e| bad(e.to_string()))?;
+    check(
+        bytes.len() <= MAX_DOCUMENT,
+        "document exceeds candidate bound",
+    )?;
+    Ok(bytes)
+}
+fn fingerprint(path: &str) -> R<(String, u64)> {
+    check(
+        Path::new(path).is_absolute() && !path.starts_with("\\\\") && !path.starts_with("//"),
+        "absolute local file required",
+    )?;
+    let mut file = fs::File::open(path).map_err(|e| bad(e.to_string()))?;
+    let before = file.metadata().map_err(|e| bad(e.to_string()))?;
+    check(
+        before.is_file() && before.len() <= 2 * 1024 * 1024 * 1024,
+        "regular source at most2GiB required",
+    )?;
+    let mut digest = Sha256::new();
+    let mut buffer = [0_u8; 65536];
+    let mut count = 0;
+    loop {
+        let n = file.read(&mut buffer).map_err(|e| bad(e.to_string()))?;
+        if n == 0 {
+            break;
+        }
+        digest.update(&buffer[..n]);
+        count += n as u64;
+    }
+    let after = file.metadata().map_err(|e| bad(e.to_string()))?;
+    let located = fs::metadata(path).map_err(|e| bad(e.to_string()))?;
+    check(
+        before.len() == count
+            && after.len() == count
+            && located.len() == count
+            && before.modified().ok() == after.modified().ok()
+            && after.modified().ok() == located.modified().ok(),
+        "source changed during point-in-time fingerprint",
+    )?;
+    Ok((format!("{:x}", digest.finalize()), count))
+}
+fn run(s: &mut Session, id: &str, p: Value) -> R<Value> {
+    s.execute(id, p)
+}
+
+/// Serde structs otherwise accept positional JSON arrays. Wire records must be objects.
+struct Object<T>(T);
+impl<'de, T: Deserialize<'de>> Deserialize<'de> for Object<T> {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct Visitor<T>(std::marker::PhantomData<T>);
+        impl<'de, T: Deserialize<'de>> serde::de::Visitor<'de> for Visitor<T> {
+            type Value = Object<T>;
+            fn expecting(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                f.write_str("a JSON object required")
+            }
+            fn visit_map<A: serde::de::MapAccess<'de>>(
+                self,
+                map: A,
+            ) -> Result<Self::Value, A::Error> {
+                T::deserialize(serde::de::value::MapAccessDeserializer::new(map)).map(Object)
+            }
+        }
+        deserializer.deserialize_map(Visitor(std::marker::PhantomData))
+    }
+}
+fn object<'de, D: serde::Deserializer<'de>, T: Deserialize<'de>>(d: D) -> Result<T, D::Error> {
+    Object::<T>::deserialize(d).map(|v| v.0)
+}
+fn objects<'de, D: serde::Deserializer<'de>, T: Deserialize<'de>>(
+    d: D,
+) -> Result<Vec<T>, D::Error> {
+    Vec::<Object<T>>::deserialize(d).map(|v| v.into_iter().map(|o| o.0).collect())
+}
+fn object_values<'de, D: serde::Deserializer<'de>, T: Deserialize<'de>>(
+    d: D,
+) -> Result<BTreeMap<String, T>, D::Error> {
+    BTreeMap::<String, Object<T>>::deserialize(d)
+        .map(|v| v.into_iter().map(|(k, o)| (k, o.0)).collect())
+}
+fn parse_object<T: serde::de::DeserializeOwned>(bytes: &[u8]) -> R<T> {
+    check(
+        bytes.len() <= MAX_DOCUMENT,
+        "document exceeds candidate bound",
+    )?;
+    serde_json::from_slice::<Object<T>>(bytes)
+        .map(|v| v.0)
+        .map_err(|e| bad(e.to_string()))
+}
+
+/// Supported static audio presentation only. Native placement owns identity/timing/link.
+fn copy_static_audio(target: &mut TrackItem, prototype: &TrackItem) {
+    target.effects.clone_from(&prototype.effects);
+    target.gain_db = prototype.gain_db;
+    target.enabled = prototype.enabled;
+    target.scale_to_frame = prototype.scale_to_frame;
+    target.essential.clone_from(&prototype.essential);
+    target
+        .source_channels
+        .clone_from(&prototype.source_channels);
+    target.audio_stream = prototype.audio_stream;
+}
+
+fn same_static_audio(a: &TrackItem, b: &TrackItem) -> bool {
+    a.effects == b.effects
+        && a.gain_db == b.gain_db
+        && a.enabled == b.enabled
+        && a.scale_to_frame == b.scale_to_frame
+        && a.essential == b.essential
+        && a.source_channels == b.source_channels
+        && a.audio_stream == b.audio_stream
+}
+
+fn validate_static_primary_audio(audio: &TrackItem) -> R<()> {
+    check(
+        audio.speed == 1.0
+            && !audio.reverse
+            && audio.frame_hold.is_none()
+            && audio.markers.is_empty()
+            && audio.effects.iter().all(|e| !e.is_animated()),
+        "only static normal-speed nonreversed audio without hold/markers is supported",
+    )?;
+    check(
+        audio.audio_stream == 0,
+        "Creator Kit supports the primary audio stream only",
+    )
+}
+
+fn validate_audio_channels(audio: &TrackItem, channels: usize) -> R<()> {
+    validate_static_primary_audio(audio)?;
+    check(
+        (1..=2).contains(&channels)
+            && audio.source_channels.len() <= 2
+            && audio
+                .source_channels
+                .iter()
+                .all(|&channel| usize::from(channel) < channels),
+        "template audio channel selection is incompatible with the actual mono/stereo source",
+    )
+}
+
+fn clip(p: &Project, seq: u64, id: u64) -> R<TrackItem> {
+    p.sequence(ItemId(seq))
+        .and_then(|q| q.find_item(ClipId(id)))
+        .map(|(_, c)| c.clone())
+        .ok_or_else(|| bad("missing native slot"))
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+struct Rect {
+    x: f64,
+    y: f64,
+    w: f64,
+    h: f64,
+}
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+struct Profile {
+    id: String,
+    scene_key: String,
+    source_width: u32,
+    source_height: u32,
+    #[serde(deserialize_with = "object_values")]
+    regions: BTreeMap<String, Rect>,
+}
+impl Profile {
+    fn validate(&self) -> R<()> {
+        check(
+            !self.id.is_empty()
+                && !self.scene_key.is_empty()
+                && self.source_width > 0
+                && self.source_height > 0,
+            "explicit scene/profile/dimensions required",
+        )?;
+        for r in self.regions.values() {
+            check(
+                [r.x, r.y, r.w, r.h].iter().all(|v| v.is_finite())
+                    && r.x >= 0.
+                    && r.y >= 0.
+                    && r.w > 0.
+                    && r.h > 0.
+                    && r.x + r.w <= 1.000000001
+                    && r.y + r.h <= 1.000000001,
+                "invalid normalized source region",
+            )?;
+        }
+        check(
+            self.regions.contains_key("gameplay"),
+            "explicit gameplay source region required",
+        )
+    }
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Slot {
+    role: String,
+    video_track: u64,
+    prototype_clip: u64,
+    audio_track: Option<u64>,
+    prototype_audio: Option<u64>,
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Composition {
+    name: String,
+    sequence: u64,
+    width: u32,
+    height: u32,
+    slots: Vec<Slot>,
+}
+#[derive(Clone, Serialize, Deserialize)]
