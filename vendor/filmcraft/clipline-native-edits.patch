+const LINKS:&str="clipline.links.v1";
+const CAPTIONS:&str="clipline.acceptedCaptions.v1";
+fn run(s:&mut Session,id:&str,p:Value)->Value{s.execute(id,p).unwrap()}
+fn snapshot(s:&Session)->Value{serde_json::to_value(&*s.project).unwrap()}
+fn metadata(s:&Session,owner:ItemId,key:&str)->Value{serde_json::from_str(&s.project.item(owner).unwrap().metadata[key]).unwrap()}
+fn seqs(s:&Session,owner:ItemId)->[u64;3]{let m=metadata(s,owner,LINKS);[m["sharedSequence"].as_u64().unwrap(),m["landscapeSequence"].as_u64().unwrap(),m["portraitSequence"].as_u64().unwrap()]}
+fn reject(s:&mut Session,id:&str,p:Value){
+ let before=snapshot(s);let ui=serde_json::to_value(&s.state).unwrap();let rev=s.revision;let journal=s.journal.clone();let history=(s.history.undo.len(),s.history.redo.len());
+ let live=s.previews.live.project().unwrap();let events=s.events.clone();
+ assert!(s.execute(id,p).is_err());assert_eq!(snapshot(s),before);assert_eq!(s.revision,rev);assert_eq!(s.journal,journal);
+ assert_eq!((s.history.undo.len(),s.history.redo.len()),history);assert_eq!(serde_json::to_value(&s.state).unwrap(),ui);assert_eq!(s.events,events);
+ assert!(Arc::ptr_eq(&live,&s.previews.live.project().unwrap()));
+}
+fn fixture()->(Session,ItemId,Value){
