+        let provenance=json!({"schema":1,"momentId":r.moment.id,"momentRevision":r.moment.revision,"kit":{"id":r.kit.id,"version":r.kit.version,"descriptorSha256":r.kit.descriptor_sha256},
+            "templateAsset":r.template,"assetRefs":descriptor.asset_refs,"sceneProfile":blueprint.profile,"sourceAsset":r.source,
+            "nativeImportedIdentity":media.identity,"requestedSourceRangeUs":{"start":r.moment.source_in_us,"end":r.moment.source_out_us},
+            "initialNativeRangeReceipt":{"sourceInTicks":source_in.0,"durationTicks":duration.0,"rate":rate,"rounding":"inward to complete native frames; receipt only, clips own later timing"}});
+        run(s,"metadata.set",json!({"item":owner.0,"field":LINKS,"value":links.to_string()}))?;
