+fn escape(text: &str) -> String {
+    text.replace('&',"&amp;").replace('<',"&lt;").replace('>',"&gt;").replace('{',"&#123;")
+}
+
+/// Build content from native gameplay source intervals. Clip/unit IDs never enter cue identity.
+fn projected(project: &Project, m: &Metadata) -> Result<Vec<Cue>> {
+    let (sequences, clips) = linked_edits::caption_bindings(project,ItemId(m.owner))?;
+    if clips.len() > MAX_OCCURRENCES || m.tracks.len() != 3 { return Err(bad("caption occurrence/track bound exceeded")); }
+    let mut track_ids = BTreeSet::new();
+    for sequence in sequences {
+        let tracks: Vec<_> = m.tracks.iter().filter(|t| t.sequence == sequence.0).collect();
+        if tracks.len() != 1 || !track_ids.insert(tracks[0].track) { return Err(bad("one distinct managed track per linked sequence required")); }
+        tracks[0].rules.native()?;
+        if tracks[0].default_settings.len() > 1024 || tracks[0].default_settings.chars().any(|c| c.is_control()) {
+            return Err(bad("bounded caption settings required"));
+        }
+        if project.sequence(sequence).is_none_or(|q| !q.caption_tracks.iter().any(|t| t.id.0 == tracks[0].track)) {
+            return Err(bad("managed caption track missing"));
+        }
+    }
+    let (resolved, media, _) = project.resolve_media(ItemId(m.source.source_item)).ok_or_else(|| bad("accepted source cannot resolve"))?;
+    if resolved.0 != m.source.resolved_media_item || media.identity != Some(m.source.stored_media_identity)
+        || !project.source_streams(ItemId(m.source.source_item)).1 {
+        return Err(bad("accepted native source/import identity differs"));
+    }
+    let primary=media.info.audio().ok_or_else(||bad("native source audio missing"))?;
+    let channels=primary.channels;
+    let expected_channels:Vec<Value>=(0..channels).map(|i|json!(i)).collect();
+    let selected=&m.input.identity["audio"]["extraction"]["selected_stream"];
+    let global=m.input.identity["source"]["audio_stream_index"].as_u64().filter(|i|*i<=64);
+    let selected_rate=selected["sample_rate"].as_u64().or_else(||selected["sample_rate"].as_str().and_then(|s|s.parse::<u64>().ok()));
+    // Native MediaInfo has audio ordinals, not global container IDs. With a single native
+    // audio stream, the canonical selected-stream probe maps that stream to primary ordinal0.
+    // The caller owns fresh source/probe verification; stored import identity is not a full SHA.
+    if media.info.audio_streams.len()!=1 || channels==0 || channels>32 || global.is_none()
+        || selected["index"].as_u64()!=global || selected["codec_type"]!="audio"
+        || selected["channels"].as_u64()!=Some(u64::from(channels)) || selected_rate!=Some(u64::from(primary.sample_rate))
+        || m.input.identity["source"]["channels"]!=json!(expected_channels) {
+        return Err(bad("prototype requires an unambiguous canonical selected stream matching sole native audio and all source channels"));
+    }
+    let accepted_end=us(m.input.identity["range"]["end_us"].as_i64().ok_or_else(||bad("source range end missing"))?)?;
+    if media.info.duration.0<=0 || accepted_end>media.info.duration {return Err(bad("accepted source range exceeds native media duration"));}
+    // markskill: one nonoverlapping source occurrence set; ceiling:512 clips, one source per owner;
+    // revisit when repeated overlapping dialogue or a second accepted source is required.
+    let mut spans = Vec::new();
+    for peers in &clips {
+        let c = &peers[0];
+        let (id, _, subclip) = project.resolve_media(c.item).ok_or_else(|| bad("gameplay source cannot resolve"))?;
+        if id != resolved || !c.enabled || !project.source_streams(c.item).1 {
+            return Err(bad("caption owner requires enabled gameplay with the pinned source audio"));
+        }
+        let end = c.source_in.0.checked_add(c.duration.0).ok_or_else(|| bad("native source interval overflow"))?;
+        if subclip.is_some_and(|r| c.source_in < r.start || Tick(end) > r.end()) {
+            return Err(bad("native gameplay exceeds Subclip source bounds"));
+        }
+        if spans.iter().any(|&(a,b)| c.source_in.0 < b && a < end) {
+            return Err(bad("ambiguous repeated overlapping source occurrence"));
+        }
+        spans.push((c.source_in.0,end));
+        for (peer,seq) in peers.iter().zip(sequences) {
+            let q = project.sequence(seq).ok_or_else(|| bad("linked sequence missing"))?;
+            let audio: Vec<_> = q.audio_tracks.iter().flat_map(|t| t.items.iter().map(move |c|(t,c)))
+                .filter(|(_,a)| peer.link.is_some() && a.link == peer.link).collect();
+            if audio.is_empty() || audio.iter().any(|(t,a)| !t.enabled || t.muted || !a.enabled
+                || (q.audio_tracks.iter().any(|tr|tr.solo) && !t.solo)) {
+                return Err(bad("inherited gameplay audio must be enabled"));
+            }
+        }
+    }
+    let mut out = Vec::new();
+    for binding in &m.tracks {
+        let seq_id = ItemId(binding.sequence);
+        let peer = sequences.iter().position(|s| *s == seq_id).ok_or_else(|| bad("unexpected caption sequence"))?;
+        let rate = project.sequence(seq_id).ok_or_else(|| bad("sequence missing"))?.settings.frame_rate;
+        let rules = binding.rules.native()?;
+        for peers in &clips {
+            let c = &peers[peer];
+            let mut words = Vec::new();
+            let mut word_ids = Vec::new();
+            for (index, word) in m.input.accepted.words.iter().enumerate() {
+                let a = us(word.timing.start_us.ok_or_else(|| bad("missing accepted start"))?)?;
+                let b = us(word.timing.end_us.ok_or_else(|| bad("missing accepted end"))?)?;
+                let mid = a.0.checked_add((b.0-a.0)/2).ok_or_else(|| bad("source midpoint overflow"))?;
+                if mid < c.source_in.0 || mid >= c.source_in.0+c.duration.0 { continue; }
+                let map = |t:Tick| -> Result<Tick> {
+                    let v = c.start.0.checked_add(t.0.checked_sub(c.source_in.0).ok_or_else(||bad("source mapping overflow"))?)
+                        .ok_or_else(||bad("native source mapping overflow"))?;
+                    Ok(Tick(v).max(c.start).min(c.end()))
+                };
+                // Caption grouping does not read confidence. Zero is an unmeasured sentinel,
+                // not an ASR score; accepted source evidence remains unchanged in metadata.
+                words.push(SeqWord { text:word.text.clone(), start:map(a)?, end:map(b)?, clip:c.id, item:c.item,
+                    index,track:0,speaker:None,confidence:0.0 });
+                word_ids.push(word.id.clone());
+            }
+            for block in caption_blocks(&words,&rules,rate) {
+                let source_limit=|key:&str|->Result<Tick>{
+                    let source=us(m.input.identity["range"][key].as_i64().ok_or_else(||bad("accepted source range missing"))?)?;
+                    let time=c.start.0.checked_add(source.0.checked_sub(c.source_in.0).ok_or_else(||bad("source limit overflow"))?)
+                        .ok_or_else(||bad("source limit overflow"))?;
+                    Ok(Tick(time).max(c.start).min(c.end()))
+                };
+                let start = block.start.max(source_limit("start_us")?);
+                let end = block.end.min(source_limit("end_us")?);
+                if end <= start { return Err(bad("caption grouping produced an empty native occurrence")); }
+                let members = word_ids.get(block.words).ok_or_else(||bad("caption membership escaped source words"))?.to_vec();
+                let occurrence = c.start.0.checked_sub(c.source_in.0).ok_or_else(||bad("occurrence origin overflow"))?;
+                let cue_id = format!("{PREFIX}{}",digest(&json!(["v1",m.input.accepted.transcript_id,seq_id.0,resolved.0,occurrence,members]))?);
+                let text = escape(&block.text);
+                if filmcraft_project::plain_text(&text) != block.text { return Err(bad("caption plain text cannot roundtrip")); }
+                out.push(Cue { sequence:seq_id.0,track:binding.track,native_id:0,cue_id,word_ids:members,start,duration:end-start,text });
+            }
+        }
+    }
+    out.sort_by_key(|c|(c.sequence,c.start));
+    let mut ids = BTreeSet::new();
+    let mut ends = BTreeMap::new();
+    for cue in &out {
+        if !ids.insert(&cue.cue_id) || ends.get(&cue.sequence).is_some_and(|e| *e > cue.start) {
+            return Err(bad("caption identities or projected ranges overlap"));
+        }
+        ends.insert(cue.sequence,cue.start+cue.duration);
+    }
+    Ok(out)
+}
