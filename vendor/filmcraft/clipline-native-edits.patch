+//! Per-launch native final document evidence. This is not process or DB authority.
+use crate::{EngineError, Result, Session};
+use serde::Deserialize;
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::BTreeSet,
+    fs,
+    io::{Read, Write},
+    path::{Component, Path, PathBuf},
+    sync::Arc,
+};
+
+const MAX_MANIFEST: u64 = 64 * 1024;
+const MAX_RECEIPT: usize = 256 * 1024;
+const MAX_DOCUMENT: u64 = 64 * 1024 * 1024;
+const KEY: &str = "clipline.creatorKit.v1";
+
+fn bad(message: impl Into<String>) -> EngineError {
+    EngineError::BadParams { cmd: "native.managedExit".into(), msg: message.into() }
+}
+fn hash(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+/// Native saved-edit identity excludes ProjectView; raw artifact hashes remain separate.
+pub(crate) fn project_sha256(project: &filmcraft_project::Project) -> String {
+    hash(&filmcraft_format::encode(project, false))
+}
+fn sha(text: &str) -> bool {
+    text.len() == 64 && text.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+fn bounded(path: &Path, max: u64) -> Result<Vec<u8>> {
+    let file = fs::File::open(path).map_err(|e| bad(e.to_string()))?;
+    let before = file.metadata().map_err(|e| bad(e.to_string()))?;
+    if !before.is_file() || before.len() == 0 || before.len() > max {
+        return Err(bad("input exceeds its bound or is not a file"));
+    }
+    let mut bytes = Vec::new();
+    file.take(max + 1).read_to_end(&mut bytes).map_err(|e| bad(e.to_string()))?;
+    if bytes.is_empty() || bytes.len() as u64 > max || bytes.len() as u64 != before.len() {
+        return Err(bad("input changed or exceeds its bound"));
+    }
+    Ok(bytes)
+}
+fn write_new(path: &Path, bytes: &[u8]) -> Result<()> {
+    let mut file = fs::OpenOptions::new().write(true).create_new(true).open(path).map_err(|e| bad(e.to_string()))?;
+    file.write_all(bytes).and_then(|()| file.sync_all()).map_err(|e| bad(e.to_string()))
+}
+fn absolute(path: &Path) -> bool {
+    path.is_absolute() && !path.components().any(|c| matches!(c, Component::ParentDir | Component::CurDir))
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+struct Manifest {
+    schema: u32,
+    nonce: String,
+    working_path: PathBuf,
+    #[serde(rename = "workingSHA256")]
+    working_sha256: String,
+    output_directory: PathBuf,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Decision {
+    Clean,
+    Save,
+    DontSave,
+    Cancel,
+}
+
+struct QuitRequest {
+    id: String,
+    decision: Option<Decision>,
+    pending: bool,
+}
+
+fn decision_name(decision: Option<Decision>) -> Option<&'static str> {
+    decision.map(|value| match value {
+        Decision::Clean => "clean",
+        Decision::Save => "save",
+        Decision::DontSave => "dont_save",
+        Decision::Cancel => "cancel",
+    })
+}
+
+/// Native UI owner, configured once at launch. No timeline or automatic publish.
+pub struct ManagedExit {
+    manifest: Manifest,
+    manifest_sha256: String,
+    initial: Value,
+    decision: Option<Decision>,
+    decision_evidence: Option<Value>,
+    post_discard: Option<Value>,
+    bypass: bool,
+    fault: Option<String>,
+    serial: u32,
+    sealed: bool,
+    request: Option<QuitRequest>,
+    request_ids: BTreeSet<String>,
+    decision_serial: u64,
+}
+
+impl ManagedExit {
+    /// Refuse malformed/stale inputs and reserve a fresh sibling output namespace.
+    /// The launcher must retain its own file guards and exact launch-byte identity.
+    pub fn load(path: &Path) -> Result<Self> {
+        if !absolute(path) {
+            return Err(bad("manifest path must be absolute and normalized"));
+        }
+        let bytes = bounded(path, MAX_MANIFEST)?;
+        let shape: Value = serde_json::from_slice(&bytes).map_err(|e| bad(e.to_string()))?;
+        if !shape.is_object() {
+            return Err(bad("managed manifest must be a named object"));
+        }
+        let manifest: Manifest = serde_json::from_slice(&bytes).map_err(|e| bad(e.to_string()))?;
+        let nonce = uuid::Uuid::parse_str(&manifest.nonce).map_err(|_| bad("invalid nonce"))?;
+        if manifest.schema != 1
+            || nonce.to_string() != manifest.nonce
+            || nonce.get_version() != Some(uuid::Version::Random)
+            || !sha(&manifest.working_sha256)
+            || !absolute(&manifest.working_path)
+            || !absolute(&manifest.output_directory)
+            || manifest.working_path.extension().is_none_or(|e| e != "fcproj")
+        {
+            return Err(bad("unsupported managed launch identity"));
+        }
+        let parent = path.parent().ok_or_else(|| bad("manifest parent missing"))?.canonicalize().map_err(|e| bad(e.to_string()))?;
+        let output_parent = manifest.output_directory.parent().ok_or_else(|| bad("output parent missing"))?.canonicalize().map_err(|e| bad(e.to_string()))?;
+        if parent != output_parent {
+            return Err(bad("output must be a fresh sibling of the managed launch manifest"));
+        }
+        if hash(&bounded(&manifest.working_path, MAX_DOCUMENT)?) != manifest.working_sha256 {
+            return Err(bad("initial working bytes differ"));
+        }
+        fs::create_dir(&manifest.output_directory).map_err(|e| bad(format!("output reservation failed: {e}")))?;
+        Ok(Self {
+            manifest,
+            manifest_sha256: hash(&bytes),
+            initial: Value::Null,
+            decision: None,
+            decision_evidence: None,
+            post_discard: None,
+            bypass: false,
+            fault: None,
+            serial: 0,
+            sealed: false,
+            request: None,
+            request_ids: BTreeSet::new(),
+            decision_serial: 0,
+        })
+    }
+
+    /// Called after native startup imports/open, before exposing the managed UI.
+    pub fn bind_initial(&mut self, s: &mut Session) -> Result<()> {
+        let identity = identity(s)?;
+        if !self.owned_path(identity.get("projectPath")) || creator_kits(&identity)?.as_object().is_none_or(|v| v.is_empty()) {
+            return Err(bad("initial native document is not the managed Creator Kit working file"));
+        }
+        if hash(&bounded(&self.manifest.working_path, MAX_DOCUMENT)?) != self.manifest.working_sha256 {
+            return Err(bad("working bytes changed during native startup"));
+        }
+        self.initial = identity;
+        Ok(())
+    }
+
+    fn owned_path(&self, value: Option<&Value>) -> bool {
+        let Some(path) = value.and_then(Value::as_str) else { return false };
+        match (Path::new(path).canonicalize(), self.manifest.working_path.canonicalize()) {
+            (Ok(observed), Ok(owned)) => observed == owned,
+            _ => false,
+        }
+    }
+
+    pub fn mark_bypass(&mut self) {
+        self.bypass = true;
+    }
+    pub fn fail(&mut self, error: impl ToString) {
+        self.fault = Some(error.to_string().chars().take(4000).collect());
+    }
+
+    /// UI dispatch binds this token immediately before the existing normal Quit action.
+    /// This is request correlation, not process cessation or a document mutation barrier.
+    pub fn begin_request(&mut self, nonce: &str, request_id: &str) -> Result<()> {
+        let parsed = uuid::Uuid::parse_str(request_id).map_err(|_| bad("invalid managed quit request ID"))?;
+        if nonce != self.manifest.nonce || parsed.to_string() != request_id || parsed.get_version() != Some(uuid::Version::Random) {
+            return Err(bad("managed quit nonce or request ID differs"));
+        }
+        if self.sealed || self.initial.is_null() || self.request.as_ref().is_some_and(|r| r.pending || r.decision != Some(Decision::Cancel)) {
+            return Err(bad("another managed quit is pending or closing"));
+        }
+        if self.request_ids.contains(request_id) || self.request_ids.len() >= 256 {
+            return Err(bad("managed quit request ID was reused or launch request bound reached"));
+        }
+        self.request_ids.insert(request_id.to_owned());
+        self.request = Some(QuitRequest { id: request_id.to_owned(), decision: None, pending: true });
+        Ok(())
+    }
+
+    fn status_value(&self, request: &QuitRequest) -> Value {
+        json!({"schema":1,"nonce":self.manifest.nonce,"requestId":request.id,
+            "decisionSerial":self.decision_serial,"pending":request.pending,"decision":decision_name(request.decision)})
+    }
+
+    /// Read-only evidence of one explicitly tagged request. No baseline-serial inference.
+    pub fn request_status(&self, nonce: &str, request_id: &str) -> Result<Value> {
+        let request = self.request.as_ref().ok_or_else(|| bad("no tagged managed quit request"))?;
+        if nonce != self.manifest.nonce || request.id != request_id {
+            return Err(bad("managed quit status identity differs"));
+        }
+        Ok(self.status_value(request))
+    }
+
+    /// The UI clears its request association after this decision. Untagged actions
+    /// still update normal exit intent, but cannot overwrite the tagged status.
+    pub fn decision_for_request(&mut self, s: &mut Session, decision: Decision, request_id: &str) -> Result<()> {
+        let request = self.request.as_mut().ok_or_else(|| bad("managed quit request missing"))?;
+        if request.id != request_id || !request.pending {
+            return Err(bad("managed quit decision request differs or already completed"));
+        }
+        self.decision_serial = self.decision_serial.checked_add(1).ok_or_else(|| bad("managed decision counter overflow"))?;
+        request.decision = Some(decision);
+        request.pending = false;
+        self.decision(s, decision)
+    }
+
+    /// Preserve explicit UI intent before Don't Save destroys its native graph.
+    pub fn decision(&mut self, s: &mut Session, decision: Decision) -> Result<()> {
+        self.decision = Some(decision);
+        self.decision_evidence = None;
+        self.post_discard = None;
+        if decision == Decision::Cancel {
+            return Ok(());
+        }
+        if decision == Decision::DontSave {
+            let memory = self.snapshot(s, "discarded_memory")?;
+            let saved = self.saved(s)?;
+            self.decision_evidence = Some(json!({"memory":memory,"saved":saved}));
+        }
+        Ok(())
+    }
+
+    /// Called only after the existing native force-close succeeded for Don't Save.
+    pub fn after_discard(&mut self, s: &mut Session) -> Result<()> {
+        self.post_discard = Some(self.snapshot(s, "post_discard")?);
+        Ok(())
+    }
+
+    fn snapshot(&mut self, s: &mut Session, role: &str) -> Result<Value> {
+        let observed = identity(s)?;
+        let bytes = crate::commands::encode_native_snapshot(s)?;
+        if bytes.len() as u64 > MAX_DOCUMENT {
+            return Err(bad("native document exceeds 64 MiB"));
+        }
+        self.serial = self.serial.checked_add(1).ok_or_else(|| bad("artifact counter overflow"))?;
+        if self.serial > 64 {
+            return Err(bad("managed artifact count exceeds its bound"));
+        }
+        let name = format!("{:02}-{role}.fcproj", self.serial);
+        write_new(&self.manifest.output_directory.join(&name), &bytes)?;
+        Ok(json!({"role":role,"artifact":name,"sha256":hash(&bytes),"bytes":bytes.len(),"identity":observed}))
+    }
+
+    fn saved(&mut self, s: &mut Session) -> Result<Value> {
+        let Some(path) = s.path.clone() else {
+            return Ok(json!({"present":false,"reason":"untitled"}));
+        };
+        let bytes = bounded(Path::new(&path), MAX_DOCUMENT)?;
+        let loaded = filmcraft_format::decode(&bytes).map_err(|e| bad(e.to_string()))?;
+        let equals_memory = loaded.project == *s.project;
+        let mut saved = Session::default();
+        saved.services = s.services.clone();
+        saved.project = Arc::new(loaded.project);
+        saved.path = Some(path.clone());
+        let mut observed = identity(&mut saved)?;
+        // File decoding has no persisted Session edit counter.
+        observed["identityOrigin"] = json!("native_decoded_saved_file");
+        observed["revision"] = Value::Null;
+        observed["savedRevision"] = Value::Null;
+        observed["dirty"] = Value::Null;
+        observed["validation"]["revision"] = Value::Null;
+        observed["validation"]["savedRevision"] = Value::Null;
+        self.serial = self.serial.checked_add(1).ok_or_else(|| bad("artifact counter overflow"))?;
+        if self.serial > 64 {
+            return Err(bad("managed artifact count exceeds its bound"));
+        }
+        let name = format!("{:02}-saved_content.fcproj", self.serial);
+        write_new(&self.manifest.output_directory.join(&name), &bytes)?;
+        Ok(json!({"present":true,"path":path,"artifact":name,"role":"saved_content",
+            "sha256":hash(&bytes),"bytes":bytes.len(),"identity":observed,"nativeProjectEqualsMemory":equals_memory}))
+    }
+
+    /// Invoke only from UI on_exit, after Session::shutdown joins persistence.
+    /// Nothing here publishes SQLite/ProjectStore or claims process cessation.
+    pub fn finalize(&mut self, s: &mut Session) -> Result<Value> {
+        if self.sealed {
+            return Err(bad("managed exit already sealed"));
+        }
+        if self.decision == Some(Decision::Cancel) {
+            return Err(bad("cancelled quit has no sealed completion"));
+        }
+        let final_memory = self.snapshot(s, "final_memory")?;
+        let final_saved = if self.decision == Some(Decision::DontSave) {
+            self.decision_evidence.as_ref().and_then(|v| v.get("saved")).cloned().ok_or_else(|| bad("discard evidence is missing"))?
+        } else {
+            self.saved(s)?
+        };
+        let saved_identity = &final_saved["identity"];
+        let initial_creator = creator_kits(&self.initial)?;
+        let same_creator = creator_kits(saved_identity).as_ref().is_ok_and(|v| v == &initial_creator);
+        let same_path = self.owned_path(final_saved.get("path"));
+        let explicit_discard = self.decision == Some(Decision::DontSave)
+            && self.post_discard.as_ref().is_some_and(|post| post["identity"] == final_memory["identity"] && post["sha256"] == final_memory["sha256"]);
+        let clean = matches!(self.decision, Some(Decision::Clean | Decision::Save))
+            && !s.is_dirty()
+            && final_saved["nativeProjectEqualsMemory"] == true
+            && creator_kits(&final_memory["identity"]).as_ref().is_ok_and(|v| v == &initial_creator);
+        let state = if self.fault.is_none() && !self.bypass && same_path && same_creator && final_saved["present"] == true {
+            if explicit_discard {
+                "discarded"
+            } else if clean {
+                "saved"
+            } else {
+                "reconciliation"
+            }
+        } else {
+            "reconciliation"
+        };
+        let receipt = json!({"schema":1,"sealedFinalExit":true,"state":state,
+            "nativeGenerator":filmcraft_format::generator(),"projectContentFingerprint":{"version":1,"viewIncluded":false,"nativeSchema":filmcraft_format::SCHEMA_VERSION},
+            "nonce":self.manifest.nonce,"launchManifestSHA256":self.manifest_sha256,
+            "workingPath":self.manifest.working_path,"initialWorkingSHA256":self.manifest.working_sha256,
+            "initialIdentity":self.initial,"decision":match self.decision {
+                Some(Decision::Clean)=>"clean",Some(Decision::Save)=>"save",Some(Decision::DontSave)=>"dont_save",
+                Some(Decision::Cancel)=>"cancel",None=>"unknown"},
+            "directBypass":self.bypass,"fault":self.fault,"decisionEvidence":self.decision_evidence,
+            "managedRequest":self.request.as_ref().map(|r| self.status_value(r)),
+            "postDiscard":self.post_discard,"finalMemory":final_memory,"savedContent":final_saved,
+            "authority":"native document evidence only; require actual owned parent reaped and Job Object active0; no canonical publication"});
+        let bytes = serde_json::to_vec(&receipt).map_err(|e| bad(e.to_string()))?;
+        if bytes.len() > MAX_RECEIPT {
+            return Err(bad("final receipt exceeds 256 KiB"));
+        }
+        // Publish a fully synced inode with an atomic, no-overwrite hard link.
+        // Filesystems without this primitive fail with retained partial evidence.
+        let pending = self.manifest.output_directory.join("receipt.pending");
+        write_new(&pending, &bytes)?;
+        fs::hard_link(&pending, self.manifest.output_directory.join("receipt.json")).map_err(|e| bad(e.to_string()))?;
+        let _ = fs::remove_file(pending);
+        self.sealed = true;
+        Ok(receipt)
+    }
+}
+
+fn identity(s: &mut Session) -> Result<Value> {
+    if s.edit_group_depth != 0 || s.trim_play.active() {
+        return Err(bad("staged native edit is not a final document"));
+    }
+    let observed = crate::export_snapshot::inspect(s)?;
+    let encoded = serde_json::to_vec(&observed).map_err(|e| bad(e.to_string()))?;
+    if encoded.len() > MAX_RECEIPT / 2 {
+        return Err(bad("native identity exceeds its bound"));
+    }
+    let mut observed = observed;
+    observed["dirty"] = json!(s.is_dirty());
+    observed["projectContentSHA256"] = json!(project_sha256(&s.project));
+    Ok(observed)
+}
+fn creator_kits(identity: &Value) -> Result<Value> {
+    let owners = identity.get("ownerMetadata").and_then(Value::as_object).ok_or_else(|| bad("native owner metadata missing"))?;
+    let mut result = serde_json::Map::new();
+    for (owner, metadata) in owners {
+        let text = metadata.get(KEY).and_then(Value::as_str).ok_or_else(|| bad("native Creator Kit identity missing"))?;
+        let body: Value = serde_json::from_str(text).map_err(|e| bad(e.to_string()))?;
+        if body.get("schema").and_then(Value::as_u64) != Some(1)
+            || !body.get("momentId").is_some_and(Value::is_string)
+            || body.get("kit").and_then(|v| v.get("descriptorSha256")).and_then(Value::as_str).is_none_or(|v| !sha(v))
+        {
+            return Err(bad("invalid native Creator Kit identity"));
+        }
+        result.insert(owner.clone(), Value::String(text.to_owned()));
+    }
+    Ok(Value::Object(result))
+}
