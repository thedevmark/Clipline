+}
+
+#[test]
+fn successful_nested_groups_publish_once_as_one_undo_step() {
+    let mut f = Fixture::new();
+    let before = f.s.previews.live.project().unwrap();
+    let undo = f.s.history.undo.len();
+    f.s.edit_group("Outer commit", |s| {
+        bin(s, "Outer A");
