+pub(crate) fn regenerate(s:&mut Session,owner:ItemId)->Result<()> {
+    let Some(mut m)=read(&s.project,owner)? else{return Ok(())};
+    let old=m.clone();
+    s.edit("Regenerate accepted captions",|p,_|install(p,&mut m,Some(&old)))
+}
+
+pub(crate) fn accept(s:&mut Session,p:&Value)->Result<Value> {
+    let object=p.as_object().ok_or_else(||bad("acceptance object required"))?;
+    for key in ["expectedProjectPath","expectedAcceptedRevision"] {
+        if !object.contains_key(key){return Err(bad(format!("explicit {key} required")));}
+    }
+    if encoded(p)?.len()>MAX_INPUT+131072{return Err(bad("acceptance command exceeds size bound"));}
+    let request:Request=serde_json::from_value(p.clone()).map_err(|e|bad(e.to_string()))?;
+    if s.path!=request.expected_project_path{return Err(bad("working project path changed"));}
+    preflight(s,"clipline.acceptCaptions")?;
+    linked_edits::validate_command(s,&json!({"expectedRevision":request.expected_revision,"expectedLinksRevisions":request.expected_links_revisions}))?;
+    validate_input(&request.projection_input)?;
+    let owner=ItemId(request.owner);
+    let old=read(&s.project,owner)?;
+    if old.as_ref().map(|m|&m.pin)!=request.expected_accepted_revision.as_ref(){return Err(bad("stale accepted revision/payload"));}
+    let pin=Pin {transcript_id:request.projection_input.accepted.transcript_id.clone(),revision:request.projection_input.accepted.revision,
+        payload_sha256:digest(&request.projection_input)?};
+    let mut pins=old.as_ref().map(|m|m.pins.clone()).unwrap_or_default();
+    if pins.iter().any(|p|p.transcript_id==pin.transcript_id && p.revision==pin.revision && p!=&pin){return Err(bad("immutable transcript revision payload changed"));}
+    if let Some(old)=&old {
+        if old.source!=request.source || encoded(&old.tracks)?!=encoded(&request.tracks)? {return Err(bad("managed source/track bindings cannot change implicitly"));}
+        for word in &request.projection_input.accepted.words {
+            if let Some(prior)=old.input.accepted.words.iter().find(|w|w.id==word.id) {
+                if word.text!=prior.text || word.parent_word_ids!=prior.parent_word_ids || word.text_origin!=prior.text_origin
+                    || word.machine_refs!=prior.machine_refs {return Err(bad("only retime may preserve a canonical accepted word ID"));}
+            }
+        }
+    }
+    if !pins.contains(&pin){pins.push(pin.clone());}
+    if pins.len()>MAX_PINS{return Err(bad("accepted pin history limit exceeded"));}
+    let mut new_observations=0;
+    for observed in &pins {
+        let key=(observed.transcript_id.clone(),observed.revision);
+        match s.accepted_caption_pins.get(&key) {
+            Some(hash) if hash!=&observed.payload_sha256=>return Err(bad("transcript revision conflicts with successful session acceptance")),
+            None=>new_observations+=1,_=>{}
+        }
+    }
+    if s.accepted_caption_pins.len()+new_observations>MAX_SESSION_PINS{return Err(bad("session accepted-pin observation limit exceeded"));}
+    let observations=pins.clone();
+    let mut m=Metadata {schema:1,owner:request.owner,pin:pin.clone(),input:request.projection_input,source:request.source,
+        tracks:request.tracks,cues:Vec::new(),pins};
+    if s.accepted_caption_accepting {return Err(bad("nested accepted-caption command unsupported"));}
+    s.accepted_caption_accepting=true;
+    let result=std::panic::catch_unwind(std::panic::AssertUnwindSafe(||
+        s.edit_group("Accept linked source words",|s|s.edit("Project accepted captions",|p,_|install(p,&mut m,old.as_ref())))));
+    s.accepted_caption_accepting=false;
+    match result {Ok(result)=>result?,Err(panic)=>std::panic::resume_unwind(panic)};
+    for observed in observations {
+        s.accepted_caption_pins.insert((observed.transcript_id,observed.revision),observed.payload_sha256);
+    }
+    Ok(json!({"owner":owner.0,"accepted":pin,"captions":m.cues.len(),"revision":s.revision,
+        "sourceIdentityCheck":"native stored import identity only; original source SHA is retained provenance, not a fresh media rehash"}))
+}
