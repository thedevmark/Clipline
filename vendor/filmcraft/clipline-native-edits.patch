+//! Workspace helper adapter. All native document logic belongs to engine::creator_kit.
+use std::{fs::File, io::Read};
+fn document(path: &str) -> Result<Vec<u8>, Box<dyn std::error::Error>> {
+    let mut bytes = Vec::new();
+    File::open(path)?
+        .take(2 * 1024 * 1024 + 1)
+        .read_to_end(&mut bytes)?;
+    if bytes.len() > 2 * 1024 * 1024 {
+        return Err("document exceeds candidate bound".into());
+    }
+    Ok(bytes)
+}
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<_> = std::env::args().collect();
+    let result = match args.get(1).map(String::as_str) {
+        Some("capture") if args.len() == 5 =>
+            filmcraft_engine::creator_kit::capture(&args[2], &document(&args[3])?, &args[4]),
+        Some("instantiate") if args.len() == 4 =>
+            filmcraft_engine::creator_kit::instantiate(&document(&args[2])?, &args[3]),
+        _ => return Err("usage: clipline-creator-kit capture SEED PROFILE_JSON NEW_TEMPLATE | instantiate REQUEST_JSON NEW_PROJECT".into()),
+    }?;
+    println!("{}", serde_json::to_string(&result)?);
+    Ok(())
+}
