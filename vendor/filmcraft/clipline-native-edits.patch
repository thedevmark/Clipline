+struct Rect {
+    x: f64,
+    y: f64,
+    w: f64,
+    h: f64,
+}
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+struct Profile {
+    id: String,
+    scene_key: String,
+    source_width: u32,
+    source_height: u32,
+    #[serde(deserialize_with = "object_values")]
+    regions: BTreeMap<String, Rect>,
+}
+impl Profile {
+    fn validate(&self) -> R<()> {
+        check(
+            !self.id.is_empty()
+                && !self.scene_key.is_empty()
+                && self.source_width > 0
+                && self.source_height > 0,
+            "explicit scene/profile/dimensions required",
+        )?;
+        for r in self.regions.values() {
+            check(
+                [r.x, r.y, r.w, r.h].iter().all(|v| v.is_finite())
+                    && r.x >= 0.
+                    && r.y >= 0.
+                    && r.w > 0.
+                    && r.h > 0.
+                    && r.x + r.w <= 1.000000001
+                    && r.y + r.h <= 1.000000001,
+                "invalid normalized source region",
+            )?;
+        }
+        check(
+            self.regions.contains_key("gameplay"),
+            "explicit gameplay source region required",
+        )
+    }
+}
