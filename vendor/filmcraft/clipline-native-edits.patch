+    f.s.edit_group("Outer success", |s| {
+        bin(s, "Keep A");
+        let outer_project = s.project.to_json();
+        let inner: Result<()> = s.edit_group("Inner rejection", |s| { bin(s, "Discard B"); reject() });
+        assert!(inner.is_err());
+        assert_eq!(s.project.to_json(), outer_project);
+        same_external(s, &before);
+        bin(s, "Keep C");
+        Ok(())
+    }).unwrap();
+    assert_eq!(f.s.history.undo.len(), undo + 1);
+    assert_eq!(f.s.journal.len(), journal + 2);
+    assert!(!f.s.project.to_json().contains("Discard B"));
+    assert_eq!(recovered(&f.s), f.s.project.to_json());
+    assert_eq!(f.s.events.iter().filter(|e| matches!(e, Event::ProjectChanged { .. })).count(), 1);
+}
+
+#[test]
+fn nested_panic_caught_by_outer_group_can_continue_without_publishing() {
+    let mut f = Fixture::new();
+    let before = f.s.previews.live.project().unwrap();
+    f.s.edit_group("Recovered outer", |s| {
+        bin(s, "Keep outer");
+        let outer = s.project.to_json();
+        let p = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _: Result<()> = s.edit_group("Inner panic", |s| { bin(s, "Discard panic"); panic!("injected") });
+        }));
+        assert!(p.is_err());
