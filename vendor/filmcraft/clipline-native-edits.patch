+/// Caller must freshly admit the exact canonical Moment/Kit/assets; this function
+/// verifies supplied consistency and point-in-time files, not database authority.
+/// Native clips own later timing. Persisted Kit/source data is a creation receipt.
+/// The return receipt hashes the exact consumed request bytes, without reserialization.
+/// A failed save can leave a partial unique file; caller owns staging/quarantine
+/// and ProjectStore publication. No database/filesystem transaction is claimed.
+pub fn instantiate(request_json: &[u8], output: &str) -> crate::Result<Value> {
+    check(
+        request_json.len() <= MAX_DOCUMENT,
+        "document exceeds candidate bound",
+    )?;
+    let request: Request = parse_object(request_json)?;
+    let mut receipt = instantiate_native(request, output)?;
+    receipt["requestSha256"] = json!(hash(request_json));
+    Ok(receipt)
