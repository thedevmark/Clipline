+//! Clipline links bind native clips; all time calculations remain in the native edit engine.
+use std::collections::{BTreeMap, BTreeSet};
+use filmcraft_edit::{Edge, TrimMode};
+use filmcraft_project::{ClipId, ItemId, MediaRef, Project, TrackItem, TrackKind};
+use filmcraft_time::Tick;
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use crate::{EngineError, Result, Session, commands};
+
+const KEY: &str = "clipline.links.v1";
+const MAX_UNITS: usize = 4096;
+const MAX_LINEAGE: usize = 8192;
+const MAX_METADATA: usize = 256 * 1024;
+const MAX_TICK: i64 = i64::MAX / 4;
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Links {
+    schema: u32,
+    revision: u64,
+    shared_sequence: u64,
+    landscape_sequence: u64,
+    portrait_sequence: u64,
+    units: Vec<Unit>,
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    lineage: Vec<Ancestor>,
+    #[serde(flatten)]
+    extra: BTreeMap<String, Value>,
+}
+#[derive(Clone, Serialize, Deserialize)]
+struct Unit {
+    id: String,
+    parent: Option<String>,
+    #[serde(default, skip_serializing_if = "is_zero")]
+    shared: u64,
+    #[serde(default, skip_serializing_if = "is_zero")]
+    landscape: u64,
+    #[serde(default, skip_serializing_if = "is_zero")]
+    portrait: u64,
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    roles: Vec<Role>,
+    #[serde(flatten)]
+    extra: BTreeMap<String, Value>,
+}
+fn is_zero(v: &u64) -> bool { *v == 0 }
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Role {
+    role: String,
+    audio: String,
+    shared: u64,
+    landscape: u64,
+    portrait: u64,
+}
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum AudioPolicy { Inherit, None }
+#[derive(Clone)]
+struct Binding { slot: usize, role: String, audio: AudioPolicy, clips: [ClipId; 3] }
+#[derive(Clone, Serialize, Deserialize)]
+struct Ancestor { id: String, parent: Option<String> }
+impl Links {
+    fn sequences(&self) -> [ItemId; 3] {
+        [ItemId(self.shared_sequence), ItemId(self.landscape_sequence), ItemId(self.portrait_sequence)]
+    }
+}
+impl Unit {
+    fn clips(&self) -> [ClipId; 3] { [ClipId(self.shared), ClipId(self.landscape), ClipId(self.portrait)] }
+    fn bind(&mut self, clips: [ClipId; 3]) {
+        [self.shared, self.landscape, self.portrait] = clips.map(|c| c.0);
+    }
+    fn bindings(&self, schema: u32) -> Result<Vec<Binding>> {
+        if self.extra.contains_key("layers") { return Err(bad("unrecognized layer bindings; use schema2 roles")); }
+        match schema {
+            1 if self.roles.is_empty() && self.clips().iter().all(|id| id.0 != 0) =>
+                Ok(vec![Binding { slot: 0, role: "gameplay".into(), audio: AudioPolicy::Inherit, clips: self.clips() }]),
+            2 if self.clips().iter().all(|id| id.0 == 0) && (1..=2).contains(&self.roles.len()) => {
+                let mut names = BTreeSet::new();
+                let mut bindings = Vec::new();
+                for (slot, role) in self.roles.iter().enumerate() {
+                    if !names.insert(role.role.as_str()) { return Err(bad("duplicate bundle role")); }
+                    let policy = match (role.role.as_str(), role.audio.as_str()) {
+                        ("gameplay", "inherit") => AudioPolicy::Inherit,
+                        ("facecam", "none") => AudioPolicy::None,
+                        _ => return Err(bad("unknown role or unsupported native audio policy")),
+                    };
+                    let clips = [ClipId(role.shared), ClipId(role.landscape), ClipId(role.portrait)];
+                    if clips.iter().any(|id| id.0 == 0) { return Err(bad("missing bundle role binding")); }
+                    bindings.push(Binding { slot, role: role.role.clone(), audio: policy, clips });
+                }
+                if !names.contains("gameplay") { return Err(bad("bundle needs one gameplay role")); }
+                Ok(bindings)
+            }
+            _ => Err(bad("invalid schema-specific unit bindings")),
+        }
+    }
+    fn bind_role(&mut self, slot: usize, schema: u32, clips: [ClipId; 3]) -> Result<()> {
+        if schema == 1 { self.bind(clips); return Ok(()); }
+        let role = self.roles.get_mut(slot).ok_or_else(|| bad("stale bundle role slot"))?;
+        [role.shared, role.landscape, role.portrait] = clips.map(|id| id.0);
+        Ok(())
+    }
+}
+
+fn bad(msg: impl Into<String>) -> EngineError {
+    EngineError::BadParams { cmd: "clipline.linkedEdit".into(), msg: msg.into() }
+}
+fn clip(s: &Session, seq: ItemId, id: ClipId) -> Result<&TrackItem> {
+    s.project.sequence(seq).and_then(|q| q.find_item(id)).map(|(_, c)| c)
+        .ok_or_else(|| bad("stale linked clip binding"))
+}
+fn safe_clip(c: &TrackItem) -> bool {
+    c.start.0 >= 0 && c.source_in.0 >= 0 && c.duration.0 > 0
+        && c.start.0.checked_add(c.duration.0).is_some_and(|v| v < MAX_TICK)
+        && c.source_in.0.checked_add(c.duration.0).is_some_and(|v| v < MAX_TICK)
+        && c.speed == 1.0 && !c.reverse && c.frame_hold.is_none()
+}
+fn validate(s: &Session, owner: ItemId, links: &Links) -> Result<()> {
+    validate_project(&s.project, owner, links, true)
+}
+fn clip_in(project: &Project, seq: ItemId, id: ClipId) -> Result<&TrackItem> {
+    project.sequence(seq).and_then(|q| q.find_item(id)).map(|(_, c)| c)
+        .ok_or_else(|| bad("stale linked clip binding"))
+}
+fn validate_project(project: &Project, owner: ItemId, links: &Links, editable: bool) -> Result<()> {
+    let sequences = links.sequences();
+    if !matches!(links.schema, 1 | 2) || owner != sequences[0] || sequences.iter().collect::<BTreeSet<_>>().len() != 3
+        || links.units.is_empty() || links.units.len() > MAX_UNITS || links.lineage.len() > MAX_LINEAGE {
+        return Err(bad("invalid linked manifest structure or unsupported schema"));
+    }
+    let rate = project.sequence(sequences[0]).ok_or_else(|| bad("missing shared sequence"))?.settings.frame_rate;
+    let mut names = BTreeSet::new();
+    for ancestor in &links.lineage {
+        if ancestor.id.is_empty() || ancestor.id.len() > 160 || !names.insert(ancestor.id.as_str()) {
+            return Err(bad("invalid or duplicate lineage identity"));
+        }
+    }
+    for unit in &links.units {
+        if unit.id.is_empty() || unit.id.len() > 160 || !names.insert(unit.id.as_str()) {
+            return Err(bad("invalid or duplicate unit identity"));
+        }
+    }
+    let live_names: BTreeSet<_> = links.units.iter().map(|u| u.id.as_str()).collect();
+    for ancestor in &links.lineage {
+        if ancestor.parent.as_ref().is_some_and(|p| p == &ancestor.id || p.is_empty() || p.len() > 160 || live_names.contains(p.as_str())) {
+            return Err(bad("invalid ancestor identity"));
+        }
+    }
+    // Walk only known ancestors, iteratively. Legacy v1 opaque roots have no stored parent.
+    let parents: BTreeMap<_, _> = links.lineage.iter().map(|a| (a.id.as_str(), a.parent.as_deref())).collect();
+    let mut complete = BTreeSet::new();
+    for start in parents.keys().copied() {
+        let mut path = BTreeSet::new();
+        let mut current = Some(start);
+        while let Some(id) = current {
+            if complete.contains(id) { break; }
+            if !path.insert(id) { return Err(bad("cycle in linked lineage")); }
+            current = parents.get(id).copied().flatten();
+        }
+        complete.extend(path);
+    }
+    let mut bindings = BTreeSet::new();
+    for unit in &links.units {
+        if unit.parent.as_ref().is_some_and(|p| p == &unit.id || p.is_empty() || p.len() > 160 || live_names.contains(p.as_str())) {
+            return Err(bad("invalid parent lineage"));
+        }
+        let roles = unit.bindings(links.schema)?;
+        let gameplay = roles.iter().find(|r| r.role == "gameplay").ok_or_else(|| bad("missing gameplay role"))?;
+        let timeline = clip_in(project, sequences[0], gameplay.clips[0])?;
+        let mut role_tracks = BTreeSet::new();
+        for role in &roles {
+            let root = clip_in(project, sequences[0], role.clips[0])?;
+            for (seq, id) in sequences.into_iter().zip(role.clips) {
+                let q = project.sequence(seq).ok_or_else(|| bad("missing linked sequence"))?;
+                if q.settings.frame_rate != rate { return Err(bad("linked sequence frame rates differ")); }
+                let (track, c) = q.find_item(id).ok_or_else(|| bad("stale linked clip binding"))?;
+                let tr = q.track(track).ok_or_else(|| bad("missing linked track"))?;
+                if tr.kind != TrackKind::Video || !bindings.insert(id) || !role_tracks.insert((seq, track)) || !safe_clip(c)
+                    || (c.item, c.start, c.duration, c.source_in) != (root.item, root.start, root.duration, root.source_in)
+                    || (c.start, c.duration) != (timeline.start, timeline.duration) {
+                    return Err(bad("bundle role timing/source diverged, shares a video track, or speed/hold unsupported"));
+                }
+                let streams = project.source_streams(c.item);
+                if !streams.0 { return Err(bad("linked video source is missing or unavailable")); }
+                let partners: Vec<_> = q.all_tracks().flat_map(|t| t.items.iter().map(move |c| (t, c)))
+                    .filter(|(_, p)| p.id == id || (c.link.is_some() && p.link == c.link)).collect();
+                match role.audio {
+                    AudioPolicy::None if c.link.is_some() => return Err(bad("audio:none role must have no native audio/video link")),
+                    AudioPolicy::Inherit if streams.1 && (c.link.is_none() || !partners.iter().any(|(t, _)| t.kind == TrackKind::Audio)) =>
+                        return Err(bad("audio-capable linked source is missing native audio ownership")),
+                    _ => {}
+                }
+                for (t, partner) in &partners {
+                    if (editable && t.locked) || !safe_clip(partner)
+                        || (partner.item, partner.start, partner.duration, partner.source_in) != (c.item, c.start, c.duration, c.source_in) {
+                        return Err(bad("linked audio/video is locked or has divergent source/timing"));
+                    }
+                    if partner.id != id && t.kind != TrackKind::Audio {
+                        return Err(bad("native audio group contains an extra video role"));
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+// Document validation scans inactive owners too; timing remains solely in native clips.
+const MAX_DOCUMENT_MANIFESTS: usize = 64;
+fn document_links(project: &Project) -> Result<Vec<(ItemId, Links)>> {
+    let mut result = Vec::new();
+    let mut sequences = BTreeSet::new();
+    let mut clips = BTreeSet::new();
+    let mut units = 0usize;
+    let mut ancestors = 0usize;
+    for item in project.items.values().filter(|i| i.metadata.contains_key(KEY)) {
+        if result.len() >= MAX_DOCUMENT_MANIFESTS { return Err(bad("too many linked manifests in document")); }
+        let text = &item.metadata[KEY];
+        if text.len() > MAX_METADATA { return Err(bad("linked metadata exceeds size limit")); }
+        let links: Links = serde_json::from_str(text).map_err(|e| bad(format!("invalid linked metadata: {e}")))?;
+        units += links.units.len();
+        ancestors += links.lineage.len();
+        if units > MAX_UNITS || ancestors > MAX_LINEAGE { return Err(bad("document linked unit/lineage limit exceeded")); }
+        validate_project(project, item.id, &links, false)?;
+        for sequence in links.sequences() {
+            if !sequences.insert(sequence) { return Err(bad("sequence belongs to multiple linked manifests")); }
+        }
+        for unit in &links.units {
+            for role in unit.bindings(links.schema)? {
+                for id in role.clips {
+                    if !clips.insert(id) { return Err(bad("clip belongs to multiple linked manifests")); }
+                }
+            }
+        }
+        result.push((item.id, links));
+    }
+    Ok(result)
+}
+
+pub(crate) fn validate_document(project: &Project) -> Result<()> {
+    document_links(project)?;
+    crate::accepted_captions::validate_document(project)
+}
+
+/// Caption projection consumes the validated native gameplay bindings, never facecam audio.
+pub(crate) fn caption_bindings(project: &Project, owner: ItemId) -> Result<([ItemId; 3], Vec<[TrackItem; 3]>)> {
+    let links = document_links(project)?.into_iter().find(|(id, _)| *id == owner)
+        .map(|(_, links)| links).ok_or_else(|| bad("caption owner has no linked manifest"))?;
+    let seqs = links.sequences();
+    let mut clips = Vec::new();
+    for unit in &links.units {
+        let roles = unit.bindings(links.schema)?;
+        let gameplay = roles.iter().find(|r| r.role == "gameplay" && r.audio == AudioPolicy::Inherit)
+            .ok_or_else(|| bad("captions require inherited gameplay audio"))?;
+        clips.push([clip_in(project, seqs[0], gameplay.clips[0])?.clone(),
+            clip_in(project, seqs[1], gameplay.clips[1])?.clone(), clip_in(project, seqs[2], gameplay.clips[2])?.clone()]);
+    }
+    Ok((seqs, clips))
+}
+
+/// Project-only edits stage a copy, so refusal occurs before history/state/publication changes.
+pub(crate) fn validate_transition(before: &Project, after: &Project, accepting_captions: bool) -> Result<()> {
+    crate::accepted_captions::validate_transition(before, after, accepting_captions)?;
+    for item in before.items.values().filter(|i| i.metadata.contains_key(KEY)) {
+        if after.item(item.id).is_none_or(|i| !i.metadata.contains_key(KEY)) {
+            return Err(bad("removing linked ownership requires an explicit detach operation"));
+        }
+    }
+    validate_document(after)
+}
+
+/// Subset exports may omit a complete linked group, but cannot silently detach one peer.
+pub(crate) fn validate_snapshot(before: &Project, snapshot: &Project) -> Result<()> {
+    for (owner, links) in document_links(before)? {
+        let present = links.sequences().map(|id| snapshot.item(id).is_some());
+        if present.iter().any(|v| *v) && (!present.iter().all(|v| *v)
+            || snapshot.item(owner).is_none_or(|i| !i.metadata.contains_key(KEY))) {
+            return Err(bad("snapshot omits a linked peer sequence"));
+        }
+    }
+    validate_document(snapshot)
+}
+
+pub(crate) fn validate_command(s: &mut Session, params: &Value) -> Result<Value> {
+    validate_document(&s.project)?;
+    let object = params.as_object().ok_or_else(|| bad("validation parameters must be an object"))?;
+    if object.keys().any(|k| k != "expectedRevision" && k != "expectedLinksRevisions") {
+        return Err(bad("unknown validation parameter"));
+    }
+    if let Some(expected) = object.get("expectedRevision") {
+        if expected.as_u64() != Some(s.revision) { return Err(bad("stale or invalid expectedRevision")); }
+    }
+    let links = document_links(&s.project)?;
+    if let Some(expected) = object.get("expectedLinksRevisions") {
+        let values = expected.as_array().ok_or_else(|| bad("expectedLinksRevisions must be an array"))?;
+        if values.len() != links.len() { return Err(bad("expectedLinksRevisions must cover every linked owner")); }
+        let mut seen = BTreeSet::new();
+        for value in values {
+            let row = value.as_object().ok_or_else(|| bad("invalid owner revision"))?;
+            if row.len() != 2 { return Err(bad("owner revision needs exactly owner and revision")); }
+            let owner = row.get("owner").and_then(Value::as_u64).ok_or_else(|| bad("invalid expected owner"))?;
+            let revision = row.get("revision").and_then(Value::as_u64).ok_or_else(|| bad("invalid expected linked revision"))?;
+            if !seen.insert(owner) || !links.iter().any(|(id, l)| id.0 == owner && l.revision == revision) {
+                return Err(bad("stale, duplicate or unknown linked owner revision"));
+            }
+        }
+    }
+    let mut owners = Vec::new();
+    for (owner, links) in links {
+        let sequences = links.sequences();
+        let mut units = Vec::new();
+        for unit in &links.units {
+            let mut roles = Vec::new();
+            for role in unit.bindings(links.schema)? {
+                let root = clip_in(&s.project, sequences[0], role.clips[0])?;
+                let resolved = s.project.resolve_media(root.item);
+                let mut native_audio = Vec::new();
+                for (seq, id) in sequences.into_iter().zip(role.clips) {
+                    let c = clip_in(&s.project, seq, id)?;
+                    let q = s.project.sequence(seq).ok_or_else(|| bad("missing linked sequence"))?;
+                    let audio: Vec<_> = q.audio_tracks.iter().flat_map(|t| &t.items)
+                        .filter(|a| c.link.is_some() && a.link == c.link).map(|a| a.id.0).collect();
+                    native_audio.push(audio);
+                }
+                roles.push(json!({"role":role.role,"audio":if role.audio == AudioPolicy::Inherit {"inherit"} else {"none"},
+                    "sourceItem":root.item.0,"resolvedMediaItem":resolved.map(|(id, _, _)|id.0),
+                    "resolvedMediaPath":resolved.and_then(|(_,m,_)|match &m.media {MediaRef::File{path}=>Some(path.as_str()),_=>None}),
+                    "storedMediaIdentity":resolved.and_then(|(_, m, _)|m.identity),
+                    "clips":{"shared":role.clips[0].0,"landscape":role.clips[1].0,"portrait":role.clips[2].0},
+                    "nativeAudioClips":{"shared":native_audio[0],"landscape":native_audio[1],"portrait":native_audio[2]}}));
+            }
+            units.push(json!({"id":unit.id,"parent":unit.parent,"roles":roles}));
+        }
+        owners.push(json!({"owner":owner.0,"schema":links.schema,"linksRevision":links.revision,
+            "sequences":{"shared":sequences[0].0,"landscape":sequences[1].0,"portrait":sequences[2].0},"units":units}));
+    }
+    Ok(json!({"valid":true,"revision":s.revision,"savedRevision":s.saved_revision,"owners":owners,
+        "sourceIdentityCheck":"native binding and stored import identity; media bytes are not rehashed"}))
+}
+
+/// Recovery/autosave retain working data, including invalid imported documents for repair.
+pub(crate) fn preflight_snapshot(s: &Session, id: &str) -> Result<()> {
+    if matches!(id, "clipline.saveSnapshot" | "clipline.validate" | "file.save" | "file.saveAs" | "file.saveCopy" | "file.saveAll" | "file.saveAsTemplate"
+        | "file.exportSelectionProject" | "file.projectManager" | "file.exportMedia" | "export.quick" | "export.queue.add"
+        | "file.exportInterchange" | "file.exportEdl" | "file.exportFcp7Xml" | "file.exportFcpxml" | "file.exportOtio"
+        | "file.exportAaf" | "file.exportOmf") {
+        validate_document(&s.project)?;
+    }
+    Ok(())
+}
+
+pub(crate) struct Plan { owner: ItemId, links: Links, indices: Vec<usize>, operation: Operation, active: usize }
+#[derive(Clone, Copy)]
+enum Operation { Split(Tick), Trim(Edge, Tick) }
+
+/// Preflight precedes dynamic-trim settlement, so a stale/rejected linked request changes nothing.
+pub(crate) fn prepare(s: &Session, id: &str, p: &Value) -> Result<Option<Plan>> {
+    let supported = matches!(id, "timeline.razor" | "timeline.trim");
+    let unsupported = matches!(id,
+        "timeline.move" | "timeline.rateStretch" | "timeline.roll" | "timeline.slip" | "timeline.slide"
+        | "clip.speedDuration" | "clip.link" | "sequence.addEdit" | "sequence.addEditAllTracks"
+        | "sequence.lift" | "sequence.extract" | "edit.clear" | "edit.rippleDelete" | "edit.rippleDeleteHead"
+        | "trim.backward" | "trim.forward" | "trim.backwardMany" | "trim.forwardMany" | "trim.nudge"
+        | "trim.extendToPlayhead" | "trim.ripplePrevious" | "trim.rippleNext" | "trim.previous" | "trim.next"
+        | "trim.shuttle" | "trim.tick" | "trim.shuttleStop" | "trim.cancelDynamic" | "trim.playAround");
+    if !supported && !unsupported { return Ok(None); }
+    let Some(active) = s.state.active_sequence else { return Ok(None); };
+    let mut found = None;
+    for item in s.project.items.values().filter(|i| i.metadata.contains_key(KEY)) {
+        let text = &item.metadata[KEY];
+        if text.len() > MAX_METADATA { return Err(bad("linked metadata exceeds size limit")); }
+        let links: Links = serde_json::from_str(text).map_err(|e| bad(format!("invalid linked metadata: {e}")))?;
+        if let Some(index) = links.sequences().iter().position(|q| *q == active) {
+            if found.is_some() { return Err(bad("sequence belongs to multiple linked manifests")); }
+            validate(s, item.id, &links)?;
+            found = Some((item.id, links, index));
+        }
+    }
+    let Some((owner, links, active_index)) = found else { return Ok(None); };
+    if unsupported { return Err(bad(format!("{id} is not supported in a linked sequence yet"))); }
+    if s.trim_play.active() { return Err(bad("finish dynamic trim playback before a linked edit")); }
+    for (key, revision) in [("expectedRevision", s.revision), ("expectedLinksRevision", links.revision)] {
+        if p.get(key).is_some() && p.get(key).and_then(Value::as_u64) != Some(revision) {
+            return Err(bad(format!("stale or invalid {key}")));
+        }
+    }
+    let q = s.project.sequence(active).ok_or_else(|| bad("missing active sequence"))?;
+    let unit_for = |id: ClipId| -> Option<usize> {
+        let target = q.find_item(id)?.1;
+        links.units.iter().position(|u| {
+            u.bindings(links.schema).is_ok_and(|roles| roles.iter().any(|role| {
+                let bound = role.clips[active_index];
+                bound == id || q.find_item(bound).is_some_and(|(_, c)| c.link.is_some() && c.link == target.link)
+            }))
+        })
+    };
+    let mut indices = BTreeSet::new();
+    let operation = if id == "timeline.razor" {
+        let time_keys = ["time", "frame", "seconds", "timecode"].into_iter().filter(|k| p.get(*k).is_some()).count();
+        if time_keys > 1 { return Err(bad("use one native time representation")); }
+        let t = commands::time_p(s, p, "").or_else(|| (time_keys == 0).then(|| s.playhead()))
+            .ok_or_else(|| bad("invalid native razor time"))?;
+        if t.0 < 0 || t.0 >= MAX_TICK { return Err(bad("razor time outside supported range")); }
+        if let Some(value) = p.get("clip") {
+            let c = value.as_u64().map(ClipId).ok_or_else(|| bad("invalid clip ID"))?;
+            let Some(index) = unit_for(c) else {
+                if q.find_item(c).is_none() { return Err(bad("stale native clip ID")); }
+                return Ok(None);
+            };
+            indices.insert(index);
+        } else {
+            let track = commands::track_p(s, p, "track", id)?;
+            let mut unlinked = false;
+            for tr in q.all_tracks().filter(|tr| !tr.locked && track.is_none_or(|id| tr.id == id)) {
+                for c in &tr.items {
+                    if c.start < t && t < c.start + c.duration {
+                        match unit_for(c.id) { Some(i) => { indices.insert(i); }, None => { unlinked = true; } }
+                    }
+                }
+            }
+            if indices.is_empty() { return Ok(None); }
+            if unlinked { return Err(bad("razor targets both linked and independent clips; select a linked clip")); }
+        }
+        for i in &indices {
+            let roles = links.units[*i].bindings(links.schema)?;
+            let gameplay = roles.iter().find(|r| r.role == "gameplay").ok_or_else(|| bad("missing gameplay role"))?;
+            let c = clip(s, active, gameplay.clips[active_index])?;
+            if !(c.start < t && t < c.start + c.duration) { return Err(bad("razor must be inside the linked unit")); }
+        }
+        if links.units.len() + indices.len() > MAX_UNITS || links.lineage.len() + indices.len() > MAX_LINEAGE {
+            return Err(bad("linked unit or lineage capacity reached"));
+        }
+        Operation::Split(t)
+    } else {
+        let c = p.get("clip").and_then(Value::as_u64).map(ClipId).ok_or_else(|| bad("need a native clip ID"))?;
+        let Some(index) = unit_for(c) else {
+            if q.find_item(c).is_none() { return Err(bad("stale native clip ID")); }
+            return Ok(None);
+        };
+        indices.insert(index);
+        if p.get("mode").is_some_and(|v| v.as_str() != Some("regular")) { return Err(bad("only regular linked trim is supported")); }
+        let edge = match p.get("edge").and_then(Value::as_str) {
+            Some("in") => Edge::In, Some("out") => Edge::Out, _ => return Err(bad("trim edge must be in or out")),
+        };
+        let d = match (p.get("delta"), p.get("deltaFrames")) {
+            (Some(v), None) => Tick(v.as_i64().ok_or_else(|| bad("invalid delta ticks"))?),
+            (None, Some(v)) => s.sequence_rate().tick_of(v.as_i64().ok_or_else(|| bad("invalid delta frames"))?),
+            _ => return Err(bad("use exactly one trim delta")),
+        };
+        if d.0 == 0 || !(-MAX_TICK..MAX_TICK).contains(&d.0) { return Err(bad("trim delta outside supported range or zero")); }
+        Operation::Trim(edge, d)
+    };
+    if p.get("unit").is_some_and(|v| indices.len() != 1 || v.as_str() != indices.first().map(|i| links.units[*i].id.as_str())) {
+        return Err(bad("stale linked unit identity"));
+    }
+    links.revision.checked_add(1).ok_or_else(|| bad("linked revision exhausted"))?;
+    Ok(Some(Plan { owner, links, indices: indices.into_iter().collect(), operation, active: active_index }))
+}
+
+impl Plan {
+    pub(crate) fn apply(mut self, s: &mut Session) -> Result<Value> {
+        crate::accepted_captions::validate_document(&s.project)?;
+        s.edit_group("Clipline shared edit", |s| {
+            let ui = s.state.clone();
+            s.state.linked_selection = true;
+            let sequences = self.links.sequences();
+            let mut cuts = 0_u64;
+            let mut applied = Tick::ZERO;
+            match self.operation {
+                Operation::Split(t) => {
+                    for index in self.indices.iter().copied().rev() {
+                        let parent = self.links.units[index].clone();
+                        let roles = parent.bindings(self.links.schema)?;
+                        let mut right = parent.clone();
+                        for role in roles {
+                            let mut right_ids = [ClipId(0); 3];
+                            for (peer, (seq, id)) in sequences.into_iter().zip(role.clips).enumerate() {
+                                let before = clip(s, seq, id)?.clone();
+                                let q = s.project.sequence(seq).ok_or_else(|| bad("missing peer"))?;
+                                let track_id = q.find_item(id).ok_or_else(|| bad("missing peer clip"))?.0;
+                                let existing: BTreeSet<_> = q.all_tracks().flat_map(|tr| tr.items.iter().map(|c| c.id)).collect();
+                                s.state.active_sequence = Some(seq);
+                                let result = s.execute_linked_native("timeline.razor", &json!({"clip":id.0,"time":t.0}))?;
+                                let q = s.project.sequence(seq).ok_or_else(|| bad("missing peer after razor"))?;
+                                let found: Vec<_> = q.track(track_id).ok_or_else(|| bad("missing peer track"))?.items.iter()
+                                    .filter(|c| !existing.contains(&c.id) && c.item == before.item && c.start == t).collect();
+                                if found.len() != 1 || found[0].effects != before.effects || clip(s, seq, id)?.effects != before.effects {
+                                    return Err(bad("native razor did not preserve a unique right clip and source-local effects"));
+                                }
+                                right_ids[peer] = found[0].id;
+                                if peer == self.active { cuts += result.get("cuts").and_then(Value::as_u64).ok_or_else(|| bad("invalid native razor result"))?; }
+                            }
+                            right.bind_role(role.slot, self.links.schema, right_ids)?;
+                        }
+                        self.links.lineage.push(Ancestor { id: parent.id.clone(), parent: parent.parent.clone() });
+                        let mut left = parent.clone();
+                        left.id = format!("unit-{}", uuid::Uuid::new_v4());
+                        right.id = format!("unit-{}", uuid::Uuid::new_v4());
+                        left.parent = Some(parent.id.clone());
+                        right.parent = Some(parent.id);
+                        self.links.units.splice(index..=index, [left, right]);
+                    }
+                }
+                Operation::Trim(edge, delta) => {
+                    let roles = self.links.units[self.indices[0]].bindings(self.links.schema)?;
+                    applied = delta;
+                    for role in &roles {
+                        for (seq, id) in sequences.into_iter().zip(role.clips) {
+                            s.state.active_sequence = Some(seq);
+                            let d = commands::trim_delta(s, id, edge, TrimMode::Regular, delta)?;
+                            if (delta.0 > 0 && d < applied) || (delta.0 < 0 && d > applied) { applied = d; }
+                        }
+                    }
+                    if applied == Tick::ZERO { return Err(bad("native engine allows no common trim delta")); }
+                    for role in &roles {
+                        for (seq, id) in sequences.into_iter().zip(role.clips) {
+                            let before = clip(s, seq, id)?.effects.clone();
+                            s.state.active_sequence = Some(seq);
+                            let result = s.execute_linked_native("timeline.trim", &json!({"clip":id.0,"edge":if edge == Edge::In {"in"} else {"out"},"mode":"regular","delta":applied.0}))?;
+                            if result.get("delta").and_then(Value::as_i64) != Some(applied.0) || clip(s, seq, id)?.effects != before {
+                                return Err(bad("native trim differs between bundle peers or changed source-local effects"));
+                            }
+                        }
+                    }
+                }
+            }
+            self.links.revision = self.links.revision.checked_add(1).ok_or_else(|| bad("linked revision exhausted"))?;
+            validate(s, self.owner, &self.links)?;
+            let text = serde_json::to_string(&self.links).map_err(|e| bad(e.to_string()))?;
+            if text.len() > MAX_METADATA { return Err(bad("linked metadata exceeds size limit")); }
+            s.execute_linked_native("metadata.set", &json!({"item":self.owner.0,"field":KEY,"value":text}))?;
+            crate::accepted_captions::regenerate(s, self.owner)?;
+            s.state = ui;
+            s.drop_stale_gap();
+            Ok(match self.operation {
+                Operation::Split(_) => json!({"cuts":cuts,"clipline":{"revision":self.links.revision,"units":self.links.units.len()}}),
+                Operation::Trim(_, _) => json!({"delta":applied.0,"clipline":{"revision":self.links.revision,"units":self.links.units.len()}}),
+            })
+        })
+    }
+}
