+   let q=s.project.sequence(seq).unwrap();
+   if role["audio"]=="none"{assert_eq!(c.link,None);}else{let audio:Vec<_>=q.audio_tracks.iter().flat_map(|t|&t.items).filter(|a|a.link.is_some()&&a.link==c.link).collect();assert_eq!(audio.len(),1);assert_eq!((audio[0].item,audio[0].start,audio[0].duration,audio[0].source_in),(c.item,c.start,c.duration,c.source_in));}
+  }}
+ }
