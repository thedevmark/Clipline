+//! Accepted CreatorLibrary words projected by native clip timing into linked caption tracks.
+use std::collections::{BTreeMap, BTreeSet};
+use filmcraft_edit::transcript::{CaptionRules, SeqWord, caption_blocks};
+use filmcraft_project::{Caption, ClipId, ItemId, MediaIdentity, Project};
+use filmcraft_time::{Tick, TICKS_PER_SECOND};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use crate::{EngineError, Result, Session, linked_edits};
+
+const KEY: &str = "clipline.acceptedCaptions.v1";
+const PREFIX: &str = "clipline-cue-";
+const MAX_INPUT: usize = 2 * 1024 * 1024;
+const MAX_METADATA: usize = 8 * 1024 * 1024;
+const MAX_WORDS: usize = 5000;
+const MAX_OCCURRENCES: usize = 512;
+const MAX_PINS: usize = 256;
+const MAX_SESSION_PINS: usize = 4096;
+
+fn bad(message: impl Into<String>) -> EngineError {
+    EngineError::BadParams { cmd: "clipline.acceptCaptions".into(), msg: message.into() }
+}
+fn encoded<T: Serialize>(value: &T) -> Result<String> {
+    serde_json::to_string(value).map_err(|e| bad(e.to_string()))
+}
+fn digest<T: Serialize>(value: &T) -> Result<String> {
+    // Value maps use sorted keys, making this independent of Rust struct field order.
+    let value = serde_json::to_value(value).map_err(|e| bad(e.to_string()))?;
+    Ok(format!("{:x}", Sha256::digest(encoded(&value)?.as_bytes())))
+}
+fn uuid(value: &str) -> Result<()> {
+    if uuid::Uuid::parse_str(value).ok().is_none_or(|v| v.to_string() != value) {
+        return Err(bad("canonical UUID required"));
+    }
+    Ok(())
+}
+fn sha(value: &str) -> bool { value.len() == 64 && value.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) }
+fn object(value: &Value, maximum: usize) -> Result<()> {
+    if !value.is_object() || encoded(value)?.len() > maximum { return Err(bad("bounded provenance object required")); }
+    Ok(())
+}
+fn us(value: i64) -> Result<Tick> {
+    if value < 0 { return Err(bad("negative source microseconds")); }
+    let ticks = value.checked_mul(TICKS_PER_SECOND / 1_000_000).ok_or_else(|| bad("source microseconds exceed native Tick range"))?;
+    if ticks >= Tick::MAX.0 { return Err(bad("source microseconds exceed supported native range")); }
+    Ok(Tick(ticks))
+}
+pub(crate) fn preflight(s:&Session,id:&str)->Result<()> {
+    if id=="clipline.acceptCaptions" && (s.trim_play.active() || s.edit_group_depth!=0) {
+        return Err(bad("acceptance requires a completed native edit state"));
+    }
+    if id=="clipline.acceptCaptions" {linked_edits::validate_document(&s.project)?;}
+    Ok(())
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Timing { start_us: Option<i64>, end_us: Option<i64>, status: String }
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Word {
+    id: String, text: String, timing: Timing, timing_provenance: Value,
+    text_origin: String, parent_word_ids: Vec<String>, machine_refs: Vec<Value>,
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Accepted {
+    transcript_id: String, revision: u64, parent_revision: Option<u64>,
+    words: Vec<Word>, created_utc: String,
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ProjectionInput { accepted: Accepted, identity: Value }
+#[derive(Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+struct Pin { transcript_id: String, revision: u64, payload_sha256: String }
+#[derive(Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+struct Source { source_item: u64, resolved_media_item: u64, stored_media_identity: MediaIdentity }
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+struct Rules {
+    max_chars: usize, lines: usize, min_duration_us: i64, max_duration_us: i64,
+    gap_frames: i64, break_pause_us: i64,
+}
+impl Rules {
+    fn native(&self) -> Result<CaptionRules> {
+        if !(1..=512).contains(&self.max_chars) || !(1..=4).contains(&self.lines)
+            || !(0..=10_000_000).contains(&self.min_duration_us)
+            || !(1..=60_000_000).contains(&self.max_duration_us)
+            || self.min_duration_us > self.max_duration_us || !(0..=60).contains(&self.gap_frames)
+            || !(0..=10_000_000).contains(&self.break_pause_us) {
+            return Err(bad("caption rules exceed supported bounds"));
+        }
+        Ok(CaptionRules { max_chars:self.max_chars, lines:self.lines,
+            min_duration:us(self.min_duration_us)?, max_duration:us(self.max_duration_us)?,
+            gap_frames:self.gap_frames, break_pause:us(self.break_pause_us)? })
+    }
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+struct Track { sequence: u64, track: u64, rules: Rules, default_settings: String }
+#[derive(Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+struct Cue {
+    sequence: u64, track: u64, native_id: u64, cue_id: String, word_ids: Vec<String>,
+    start: Tick, duration: Tick, text: String,
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Metadata {
+    schema: u32, owner: u64, pin: Pin, input: ProjectionInput, source: Source,
+    tracks: Vec<Track>, cues: Vec<Cue>, pins: Vec<Pin>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+struct Request {
+    owner: u64, expected_project_path: Option<String>, expected_revision: u64,
+    expected_links_revisions: Value, expected_accepted_revision: Option<Pin>,
+    projection_input: ProjectionInput, source: Source, tracks: Vec<Track>,
+}
+
+fn read(project: &Project, owner: ItemId) -> Result<Option<Metadata>> {
+    let Some(text) = project.item(owner).and_then(|i| i.metadata.get(KEY)) else { return Ok(None) };
+    if text.len() > MAX_METADATA { return Err(bad("accepted caption metadata exceeds size bound")); }
+    serde_json::from_str(text).map(Some).map_err(|e| bad(format!("invalid accepted caption metadata: {e}")))
+}
+fn validate_input(input: &ProjectionInput) -> Result<()> {
+    if encoded(input)?.len() > MAX_INPUT { return Err(bad("accepted input exceeds size bound")); }
+    let accepted = &input.accepted;
+    uuid(&accepted.transcript_id)?;
+    if accepted.revision == 0 || accepted.parent_revision.is_some_and(|r| r >= accepted.revision)
+        || accepted.created_utc.is_empty() || accepted.created_utc.len() > 128 || accepted.words.len() > MAX_WORDS {
+        return Err(bad("invalid pinned transcript revision"));
+    }
+    let identity = input.identity.as_object().ok_or_else(|| bad("source identity required"))?;
+    if identity.len() != 3 || !identity.contains_key("source") || !identity.contains_key("audio") || !identity.contains_key("range") {
+        return Err(bad("identity requires source/audio/range"));
+    }
+    object(&input.identity, 65536)?;
+    let source = &input.identity["source"];
+    uuid(source["asset_id"].as_str().ok_or_else(|| bad("source asset UUID required"))?)?;
+    if !source["sha256"].as_str().is_some_and(sha) { return Err(bad("original source SHA provenance required")); }
+    let audio = &input.identity["audio"];
+    if !audio["pcm_sha256"].as_str().is_some_and(sha) || !audio["wav_sha256"].as_str().is_some_and(sha)
+        || audio["sample_zero_source_us"].as_i64().is_none_or(|v| v < 0) {
+        return Err(bad("canonical extraction identity required"));
+    }
+    let range = &input.identity["range"];
+    let lo = us(range["start_us"].as_i64().ok_or_else(|| bad("source range start required"))?)?;
+    let hi = us(range["end_us"].as_i64().ok_or_else(|| bad("source range end required"))?)?;
+    if lo >= hi { return Err(bad("invalid source range")); }
+    let bounded_integer=|v:&Value,min:i64,max:i64|v.as_i64().filter(|v|*v>=min && *v<=max).ok_or_else(||bad("invalid canonical audio identity"));
+    let rate=bounded_integer(&audio["sample_rate"],1,384000)?;
+    let count=bounded_integer(&audio["sample_count"],1,i64::MAX)?;
+    bounded_integer(&audio["channels"],1,32)?;
+    bounded_integer(&audio["sample_width"],1,8)?;
+    let zero=bounded_integer(&audio["sample_zero_source_us"],0,i64::MAX)?;
+    let range_start=range["start_us"].as_i64().ok_or_else(||bad("source start required"))?;
+    let range_end=range["end_us"].as_i64().ok_or_else(||bad("source end required"))?;
+    if range_start<zero || i128::from(range_end-zero)*i128::from(rate)>i128::from(count)*1_000_000 {
+        return Err(bad("source range exceeds canonical prepared sample clock"));
+    }
+    let extraction=&audio["extraction"];
+    if extraction["source_sha256"]!=source["sha256"]
+        || extraction["tool_version"].as_str().is_none_or(str::is_empty)
+        || extraction["argv"].as_array().is_none_or(|a|a.is_empty() || a.len()>256 || a.iter().any(|v|v.as_str().is_none_or(|s|s.len()>4096))) {
+        return Err(bad("bound extraction provenance required"));
+    }
+    let mut previous = lo;
+    let mut ids = BTreeSet::new();
+    for word in &accepted.words {
+        uuid(&word.id)?;
+        if !ids.insert(&word.id) || word.text.is_empty() || word.text.chars().count() > 512
+            || word.text.chars().any(|c| c.is_whitespace() || c.is_control()) {
+            return Err(bad("invalid or duplicate accepted word"));
+        }
+        if !matches!(word.timing.status.as_str(), "aligned" | "manually_timed" | "inherited") {
+            return Err(bad("missing, unresolved or interpolated words require explicit timing review"));
+        }
+        let a = us(word.timing.start_us.ok_or_else(|| bad("accepted word has no source start"))?)?;
+        let b = us(word.timing.end_us.ok_or_else(|| bad("accepted word has no source end"))?)?;
+        if a < previous || a < lo || b <= a || b > hi { return Err(bad("accepted words must be ordered inside source range")); }
+        previous = b;
+        object(&word.timing_provenance,4096)?;
+        if word.timing_provenance.as_object().is_none_or(|v| v.is_empty())
+            || !matches!(word.text_origin.as_str(), "machine_accepted" | "human")
+            || word.parent_word_ids.len() > MAX_WORDS || word.machine_refs.len() > 64 {
+            return Err(bad("invalid canonical word provenance"));
+        }
+        let mut parents = BTreeSet::new();
+        for parent in &word.parent_word_ids {
+            uuid(parent)?;
+            if parent == &word.id || !parents.insert(parent) { return Err(bad("invalid parent word identity")); }
+        }
+        for reference in &word.machine_refs { object(reference,4096)?; }
+    }
+    Ok(())
+}
+
+fn escape(text: &str) -> String {
+    text.replace('&',"&amp;").replace('<',"&lt;").replace('>',"&gt;").replace('{',"&#123;")
+}
+
+/// Build content from native gameplay source intervals. Clip/unit IDs never enter cue identity.
+fn projected(project: &Project, m: &Metadata) -> Result<Vec<Cue>> {
+    let (sequences, clips) = linked_edits::caption_bindings(project,ItemId(m.owner))?;
+    if clips.len() > MAX_OCCURRENCES || m.tracks.len() != 3 { return Err(bad("caption occurrence/track bound exceeded")); }
+    let mut track_ids = BTreeSet::new();
+    for sequence in sequences {
+        let tracks: Vec<_> = m.tracks.iter().filter(|t| t.sequence == sequence.0).collect();
+        if tracks.len() != 1 || !track_ids.insert(tracks[0].track) { return Err(bad("one distinct managed track per linked sequence required")); }
+        tracks[0].rules.native()?;
+        if tracks[0].default_settings.len() > 1024 || tracks[0].default_settings.chars().any(|c| c.is_control()) {
+            return Err(bad("bounded caption settings required"));
+        }
+        if project.sequence(sequence).is_none_or(|q| !q.caption_tracks.iter().any(|t| t.id.0 == tracks[0].track)) {
+            return Err(bad("managed caption track missing"));
+        }
+    }
+    let (resolved, media, _) = project.resolve_media(ItemId(m.source.source_item)).ok_or_else(|| bad("accepted source cannot resolve"))?;
+    if resolved.0 != m.source.resolved_media_item || media.identity != Some(m.source.stored_media_identity)
+        || !project.source_streams(ItemId(m.source.source_item)).1 {
+        return Err(bad("accepted native source/import identity differs"));
+    }
+    let primary=media.info.audio().ok_or_else(||bad("native source audio missing"))?;
+    let channels=primary.channels;
+    let expected_channels:Vec<Value>=(0..channels).map(|i|json!(i)).collect();
+    let selected=&m.input.identity["audio"]["extraction"]["selected_stream"];
+    let global=m.input.identity["source"]["audio_stream_index"].as_u64().filter(|i|*i<=64);
+    let selected_rate=selected["sample_rate"].as_u64().or_else(||selected["sample_rate"].as_str().and_then(|s|s.parse::<u64>().ok()));
+    // Native MediaInfo has audio ordinals, not global container IDs. With a single native
+    // audio stream, the canonical selected-stream probe maps that stream to primary ordinal0.
+    // The caller owns fresh source/probe verification; stored import identity is not a full SHA.
+    if media.info.audio_streams.len()!=1 || channels==0 || channels>32 || global.is_none()
+        || selected["index"].as_u64()!=global || selected["codec_type"]!="audio"
+        || selected["channels"].as_u64()!=Some(u64::from(channels)) || selected_rate!=Some(u64::from(primary.sample_rate))
+        || m.input.identity["source"]["channels"]!=json!(expected_channels) {
+        return Err(bad("prototype requires an unambiguous canonical selected stream matching sole native audio and all source channels"));
+    }
+    let accepted_end=us(m.input.identity["range"]["end_us"].as_i64().ok_or_else(||bad("source range end missing"))?)?;
+    if media.info.duration.0<=0 || accepted_end>media.info.duration {return Err(bad("accepted source range exceeds native media duration"));}
+    // markskill: one nonoverlapping source occurrence set; ceiling:512 clips, one source per owner;
+    // revisit when repeated overlapping dialogue or a second accepted source is required.
+    let mut spans = Vec::new();
+    for peers in &clips {
+        let c = &peers[0];
+        let (id, _, subclip) = project.resolve_media(c.item).ok_or_else(|| bad("gameplay source cannot resolve"))?;
+        if id != resolved || !c.enabled || !project.source_streams(c.item).1 {
+            return Err(bad("caption owner requires enabled gameplay with the pinned source audio"));
+        }
+        let end = c.source_in.0.checked_add(c.duration.0).ok_or_else(|| bad("native source interval overflow"))?;
+        if subclip.is_some_and(|r| c.source_in < r.start || Tick(end) > r.end()) {
+            return Err(bad("native gameplay exceeds Subclip source bounds"));
+        }
+        if spans.iter().any(|&(a,b)| c.source_in.0 < b && a < end) {
+            return Err(bad("ambiguous repeated overlapping source occurrence"));
+        }
+        spans.push((c.source_in.0,end));
+        for (peer,seq) in peers.iter().zip(sequences) {
+            let q = project.sequence(seq).ok_or_else(|| bad("linked sequence missing"))?;
+            let audio: Vec<_> = q.audio_tracks.iter().flat_map(|t| t.items.iter().map(move |c|(t,c)))
+                .filter(|(_,a)| peer.link.is_some() && a.link == peer.link).collect();
+            if audio.is_empty() || audio.iter().any(|(t,a)| !t.enabled || t.muted || !a.enabled
+                || (q.audio_tracks.iter().any(|tr|tr.solo) && !t.solo)) {
+                return Err(bad("inherited gameplay audio must be enabled"));
+            }
+        }
+    }
+    let mut out = Vec::new();
+    for binding in &m.tracks {
+        let seq_id = ItemId(binding.sequence);
+        let peer = sequences.iter().position(|s| *s == seq_id).ok_or_else(|| bad("unexpected caption sequence"))?;
+        let rate = project.sequence(seq_id).ok_or_else(|| bad("sequence missing"))?.settings.frame_rate;
+        let rules = binding.rules.native()?;
+        for peers in &clips {
+            let c = &peers[peer];
+            let mut words = Vec::new();
+            let mut word_ids = Vec::new();
+            for (index, word) in m.input.accepted.words.iter().enumerate() {
+                let a = us(word.timing.start_us.ok_or_else(|| bad("missing accepted start"))?)?;
+                let b = us(word.timing.end_us.ok_or_else(|| bad("missing accepted end"))?)?;
+                let mid = a.0.checked_add((b.0-a.0)/2).ok_or_else(|| bad("source midpoint overflow"))?;
+                if mid < c.source_in.0 || mid >= c.source_in.0+c.duration.0 { continue; }
+                let map = |t:Tick| -> Result<Tick> {
+                    let v = c.start.0.checked_add(t.0.checked_sub(c.source_in.0).ok_or_else(||bad("source mapping overflow"))?)
+                        .ok_or_else(||bad("native source mapping overflow"))?;
+                    Ok(Tick(v).max(c.start).min(c.end()))
+                };
+                // Caption grouping does not read confidence. Zero is an unmeasured sentinel,
+                // not an ASR score; accepted source evidence remains unchanged in metadata.
+                words.push(SeqWord { text:word.text.clone(), start:map(a)?, end:map(b)?, clip:c.id, item:c.item,
+                    index,track:0,speaker:None,confidence:0.0 });
+                word_ids.push(word.id.clone());
+            }
+            for block in caption_blocks(&words,&rules,rate) {
+                let source_limit=|key:&str|->Result<Tick>{
+                    let source=us(m.input.identity["range"][key].as_i64().ok_or_else(||bad("accepted source range missing"))?)?;
+                    let time=c.start.0.checked_add(source.0.checked_sub(c.source_in.0).ok_or_else(||bad("source limit overflow"))?)
+                        .ok_or_else(||bad("source limit overflow"))?;
+                    Ok(Tick(time).max(c.start).min(c.end()))
+                };
+                let start = block.start.max(source_limit("start_us")?);
+                let end = block.end.min(source_limit("end_us")?);
+                if end <= start { return Err(bad("caption grouping produced an empty native occurrence")); }
+                let members = word_ids.get(block.words).ok_or_else(||bad("caption membership escaped source words"))?.to_vec();
+                let occurrence = c.start.0.checked_sub(c.source_in.0).ok_or_else(||bad("occurrence origin overflow"))?;
+                let cue_id = format!("{PREFIX}{}",digest(&json!(["v1",m.input.accepted.transcript_id,seq_id.0,resolved.0,occurrence,members]))?);
+                let text = escape(&block.text);
+                if filmcraft_project::plain_text(&text) != block.text { return Err(bad("caption plain text cannot roundtrip")); }
+                out.push(Cue { sequence:seq_id.0,track:binding.track,native_id:0,cue_id,word_ids:members,start,duration:end-start,text });
+            }
+        }
+    }
+    out.sort_by_key(|c|(c.sequence,c.start));
+    let mut ids = BTreeSet::new();
+    let mut ends = BTreeMap::new();
+    for cue in &out {
+        if !ids.insert(&cue.cue_id) || ends.get(&cue.sequence).is_some_and(|e| *e > cue.start) {
+            return Err(bad("caption identities or projected ranges overlap"));
+        }
+        ends.insert(cue.sequence,cue.start+cue.duration);
+    }
+    Ok(out)
+}
+
+fn validate_metadata(project: &Project, m: &Metadata) -> Result<()> {
+    if m.schema != 1 || m.pins.len() > MAX_PINS { return Err(bad("invalid accepted caption schema/history")); }
+    validate_input(&m.input)?;
+    let expected_pin = Pin { transcript_id:m.input.accepted.transcript_id.clone(),revision:m.input.accepted.revision,payload_sha256:digest(&m.input)? };
+    if m.pin != expected_pin || !m.pins.contains(&m.pin) { return Err(bad("accepted payload hash differs")); }
+    let mut pins = BTreeSet::new();
+    for pin in &m.pins {
+        uuid(&pin.transcript_id)?;
+        if pin.revision == 0 || !sha(&pin.payload_sha256) || !pins.insert((&pin.transcript_id,pin.revision)) {
+            return Err(bad("invalid immutable transcript pin"));
+        }
+    }
+    let expected = projected(project,m)?;
+    if expected.len() != m.cues.len() { return Err(bad("managed caption membership differs")); }
+    let mut native_ids = BTreeSet::new();
+    for (expected,receipt) in expected.iter().zip(&m.cues) {
+        let mut actual = receipt.clone(); actual.native_id = 0;
+        if actual != *expected || receipt.native_id == 0 || !native_ids.insert(receipt.native_id) {
+            return Err(bad("managed caption receipt differs"));
+        }
+        let track = project.sequence(ItemId(receipt.sequence)).and_then(|q|q.caption_tracks.iter().find(|t|t.id.0==receipt.track))
+            .ok_or_else(||bad("managed caption track missing"))?;
+        let matches: Vec<_> = track.captions.iter().filter(|c|c.id.0==receipt.native_id).collect();
+        if matches.len()!=1 { return Err(bad("managed caption missing or double bound")); }
+        let c=matches[0];
+        if c.start!=receipt.start || c.duration!=receipt.duration || c.text!=receipt.text || c.speaker.is_some()
+            || c.cue_id.as_deref()!=Some(receipt.cue_id.as_str()) || c.settings.len()>1024 {
+            return Err(bad("manual managed-caption edit requires explicit accepted-word correction"));
+        }
+    }
+    for binding in &m.tracks {
+        let q=project.sequence(ItemId(binding.sequence)).ok_or_else(||bad("managed sequence missing"))?;
+        let track=q.caption_tracks.iter().find(|t|t.id.0==binding.track).ok_or_else(||bad("managed track missing"))?;
+        for c in &track.captions {
+            if c.cue_id.as_deref().is_some_and(|id|id.starts_with(PREFIX)) && !native_ids.contains(&c.id.0) {
+                return Err(bad("untracked managed caption"));
+            }
+            if !native_ids.contains(&c.id.0) && m.cues.iter().filter(|r|r.sequence==binding.sequence)
+                .any(|r|c.start<r.start+r.duration && r.start<c.end()) {
+                return Err(bad("unmanaged caption overlaps accepted projection"));
+            }
+        }
+        q.check().map_err(bad)?;
+    }
+    Ok(())
+}
+pub(crate) fn validate_document(project:&Project)->Result<()> {
+    let mut count=0;
+    let mut bindings=BTreeSet::new();
+    for item in project.items.values().filter(|i|i.metadata.contains_key(KEY)) {
+        count+=1;if count>8 {return Err(bad("accepted owner limit exceeded"));}
+        let m=read(project,item.id)?.ok_or_else(||bad("accepted metadata missing"))?;
+        if m.owner!=item.id.0 {return Err(bad("accepted owner differs"));}
+        for track in &m.tracks {if !bindings.insert((track.sequence,track.track)){return Err(bad("managed track double bound"));}}
+        validate_metadata(project,&m)?;
+    }
+    Ok(())
+}
+pub(crate) fn validate_transition(before:&Project,after:&Project,accepting:bool)->Result<()> {
+    for item in before.items.values().filter(|i|i.metadata.contains_key(KEY)) {
+        if after.item(item.id).is_none_or(|i|!i.metadata.contains_key(KEY)) {
+            return Err(bad("accepted caption ownership requires explicit detach"));
+        }
+    }
+    if !accepting {
+        for item in after.items.values().filter(|i|i.metadata.contains_key(KEY)) {
+            let old=read(before,item.id)?.ok_or_else(||bad("use the native acceptance command to create managed captions"))?;
+            let new=read(after,item.id)?.ok_or_else(||bad("accepted metadata missing"))?;
+            if old.pin!=new.pin || encoded(&old.input)?!=encoded(&new.input)? || old.source!=new.source
+                || encoded(&old.tracks)?!=encoded(&new.tracks)? || old.pins!=new.pins {
+                return Err(bad("accepted source words require explicit native acceptance"));
+            }
+        }
+    }
+    Ok(())
+}
+
+fn install(project:&mut Project,m:&mut Metadata,old:Option<&Metadata>)->Result<()> {
+    let mut cues=projected(project,m)?;
+    for binding in &m.tracks {
+        let q=project.sequence(ItemId(binding.sequence)).ok_or_else(||bad("managed sequence missing"))?;
+        let track=q.caption_tracks.iter().find(|t|t.id.0==binding.track).ok_or_else(||bad("managed track missing"))?;
+        if track.locked {return Err(bad("managed caption track is locked"));}
+    }
+    let mut retained=BTreeMap::new();
+    let mut settings=BTreeMap::new();
+    let mut old_ids=BTreeSet::new();
+    if let Some(old)=old {
+        for r in &old.cues {
+            let c=project.sequence(ItemId(r.sequence)).and_then(|q|q.caption_tracks.iter().find(|t|t.id.0==r.track))
+                .and_then(|t|t.captions.iter().find(|c|c.id.0==r.native_id)).ok_or_else(||bad("prior managed caption missing"))?;
+            retained.insert(r.cue_id.clone(),c.clone());old_ids.insert(c.id);
+            for word in &r.word_ids {settings.insert((r.sequence,word.clone()),c.settings.clone());}
+        }
+    }
+    let mut created=BTreeMap::<u64,Vec<Caption>>::new();
+    for cue in &mut cues {
+        let binding=m.tracks.iter().find(|t|t.sequence==cue.sequence).ok_or_else(||bad("caption binding missing"))?;
+        let mut setting=binding.default_settings.clone();
+        let mut selected=BTreeSet::new();
+        for id in &cue.word_ids {
+            if let Some(value)=settings.get(&(cue.sequence,id.clone())) {selected.insert(value.clone());}
+            if let Some(word)=m.input.accepted.words.iter().find(|w|&w.id==id) {
+                for parent in &word.parent_word_ids {
+                    if let Some(value)=settings.get(&(cue.sequence,parent.clone())) {selected.insert(value.clone());}
+                }
+            }
+        }
+        if selected.is_empty() {
+            if let Some(old)=old {
+                for prior in old.cues.iter().filter(|r|r.sequence==cue.sequence && r.start<cue.start+cue.duration && cue.start<r.start+r.duration) {
+                    if let Some(value)=retained.get(&prior.cue_id) {selected.insert(value.settings.clone());}
+                }
+            }
+        }
+        if selected.len()>1 {return Err(bad("caption regrouping has conflicting native settings"));}
+        if let Some(value)=selected.into_iter().next(){setting=value;}
+        let id=retained.get(&cue.cue_id).map(|c|c.id).unwrap_or_else(||ClipId(project.alloc_id()));
+        cue.native_id=id.0;
+        created.entry(cue.sequence).or_default().push(Caption {id,start:cue.start,duration:cue.duration,text:cue.text.clone(),
+            speaker:None,cue_id:Some(cue.cue_id.clone()),settings:setting});
+    }
+    for binding in &m.tracks {
+        let q=project.sequence_mut(ItemId(binding.sequence)).ok_or_else(||bad("managed sequence missing"))?;
+        let track=q.caption_tracks.iter_mut().find(|t|t.id.0==binding.track).ok_or_else(||bad("managed track missing"))?;
+        track.captions.retain(|c|!old_ids.contains(&c.id));
+        track.captions.extend(created.remove(&binding.sequence).unwrap_or_default());
+        track.captions.sort_by_key(|c|c.start);
+    }
+    m.cues=cues;
+    let text=encoded(m)?;
+    if text.len()>MAX_METADATA{return Err(bad("accepted caption metadata exceeds size bound"));}
+    project.items.get_mut(&ItemId(m.owner)).ok_or_else(||bad("accepted owner missing"))?.metadata.insert(KEY.into(),text);
+    validate_metadata(project,m)
+}
